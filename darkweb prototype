  const rels = actorId ? relationshipsForActor(actorId) : [];
  const ev = actorId ? evidenceForActor(actorId) : [];
  const tl = actorId ? timelineForActor(actorId) : [];
  const persona = actorId ? personaForActor(actorId) : [];
  const infra = actorId ? infraForActor(actorId) : [];

  const mask = (s) => (redact && (tlp === "RED" || tlp === "AMBER+STRICT") ? String(s || "").replace(/.(?=.{4})/g, "•") : s);

  useEffect(() => {
    if (!actorId || !actor) return;
    let cancelled = false;
    setBuildingStix(true);
    buildStixBundle(actor, ev, rels).then(b => { if (!cancelled) { setStix(b); setBuildingStix(false); } });
    return () => { cancelled = true; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [actorId]);

  if (!actor) {
    return <EmptyState icon={FileText} title="No actors to report on" sub="Add an actor via Intelligence Intake, then come back to generate an investigation report." />;
  }

  const reportObj = {
    reportId: `RPT-${actorId}-${Date.now().toString().slice(-6)}`,
    generated: new Date().toISOString(),
    tlp,
    executiveSummary: `Investigation into "${actor.primaryAlias}" (${actor.id}) assessed at ${attr.overall}% attribution confidence, false-positive risk ${attr.fpRisk}.`,
    actorProfile: actor,
    knownAliases: actor.aliases,
    infrastructureFindings: infra.map(i => ({ ...i, ip: mask(i.ip), domain: mask(i.domain), certFingerprint: mask(i.certFingerprint) })),
    identifierCorrelations: rels.filter(r => ["SAME_HANDLE", "SHARED_PGP", "SHARED_WALLET"].includes(r.type)),
    personaAnalysis: persona,
    relationshipAnalysis: rels,
    evidence: ev,
    timeline: tl,
    attributionAssessment: attr,
    falsePositiveConsiderations: rels.filter(r => r.falsePositiveRisk !== "Low").map(r => r.reason),
    analystNotes: "Assessment is based on correlated digital indicators and does not independently establish a real-world identity. Recommend continued monitoring and corroboration of persona-based linkages.",
  };

  // Shared, hardened download helper. The bug behind the blank white page on
  // every export button (JSON/CSV/STIX/Print) was the same in all four: a
  // Blob URL was assigned to an <a download> that was never attached to the
  // DOM, then .click()'d, then the object URL was revoked on the very next
  // line. Inside this artifact's sandboxed preview iframe a detached
  // anchor's programmatic click is unreliable — instead of downloading, the
  // browser can fall back to *navigating the current page* to the blob:
  // URL, and then immediately finds that URL already revoked (we revoked it
  // synchronously right after calling click()), which is what left the
  // whole report view blank. The fix: attach the anchor to the document,
  // click it, remove it, and only revoke the object URL after a delay long
  // enough for the browser to have started reading it.
  const triggerFileSave = (filename, mimeType, content) => {
    try {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = filename;
      link.rel = "noopener noreferrer";
      link.style.display = "none";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      setTimeout(() => URL.revokeObjectURL(url), 4000);
      return true;
    } catch (e) {
      return false;
    }
  };

  const downloadJSON = () => {
    const ok = triggerFileSave(`${reportObj.reportId}_${tlp.replace("+", "")}.json`, "application/json", JSON.stringify(reportObj, null, 2));
    if (!ok) notifyToast("Couldn't start the download in this preview.", "error");
  };
  const downloadCSV = () => {
    const rows = [
      ["Section", "Field", "Value"],
      ["Actor", "ID", actor.id], ["Actor", "Primary Alias", actor.primaryAlias], ["Actor", "Category", actor.category],
      ["Actor", "Risk", actor.riskLevel], ["Actor", "Status", actor.status],
      ["Attribution", "Overall Confidence", `${attr.overall}%`], ["Attribution", "False Positive Risk", attr.fpRisk],
      ...rels.map(r => ["Relationship", r.type, `${actorById(r.source).primaryAlias} -> ${actorById(r.target).primaryAlias} (${r.confidence}%)`]),
      ...ev.map(e => ["Evidence", e.id, e.description]),
    ];
    const csv = Papa.unparse(rows);
    const ok = triggerFileSave(`${reportObj.reportId}.csv`, "text/csv", csv);
    if (!ok) notifyToast("Couldn't start the download in this preview.", "error");
  };
  const downloadStix = () => {
    if (!stix) return;
    const ok = triggerFileSave(`${actor.id}_stix_bundle.json`, "application/json", JSON.stringify(stix, null, 2));
    if (!ok) notifyToast("Couldn't start the download in this preview.", "error");
  };
  // Print / PDF: this artifact runs inside a sandboxed preview iframe, where
  // window.print() on the CURRENT document is frequently blocked (sandboxed
  // iframes need "allow-modals" for print() to actually open a dialog).
  // Building the printable HTML and opening it in a real, unsandboxed
  // browser tab avoids that entirely — but that tab must be navigated
  // straight to a Blob URL. Using window.open("", "_blank") followed by
  // document.open()/write()/close() (the previous approach) is unreliable
  // in restricted/sandboxed popup contexts and frequently just leaves the
  // new tab blank instead of raising an error we could catch. Navigating
  // the opened tab directly to a Blob URL is the standard, reliable way to
  // do this. If the popup is blocked, fall back to downloading that same
  // HTML file via the hardened triggerFileSave helper above.
  const printReport = () => {
    const contentHtml = printRef.current ? printRef.current.innerHTML : "";
    const doc = `<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>${reportObj.reportId}</title>
<style>
  * { box-sizing: border-box; }
  body { font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif; color: #111; background: #fff; margin: 0; padding: 0.5in; }
  h2 { color: #000; font-size: 16px; margin: 0; }
  p { margin: 0 0 4px; }
  *, *::before, *::after { border-color: #999 !important; background: transparent !important; color: #111 !important; }
  .font-mono, code { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  @media print { body { padding: 0.4in; } }
</style>
</head>
<body>${contentHtml}</body>
</html>`;

    const blob = new Blob([doc], { type: "text/html" });
    const url = URL.createObjectURL(blob);

    let openedTab = null;
    try {
      openedTab = window.open(url, "_blank", "noopener");
    } catch (e) { openedTab = null; }

    if (openedTab) {
      // Give the new tab time to actually load the Blob URL before we
      // revoke it out from under it — revoking too early is what produced
      // the blank tab.
      setTimeout(() => { try { openedTab.print(); } catch (e) { /* ignore */ } }, 600);
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    } else {
      URL.revokeObjectURL(url);
      const ok = triggerFileSave(`${reportObj.reportId}_print.html`, "text/html", doc);
      if (ok) {
        notifyToast("Pop-ups are blocked in this preview — downloaded a print-ready HTML file instead. Open it in a browser tab, then print or save as PDF from there.", "info");
      } else {
        notifyToast("Couldn't open a print tab or start a download in this preview.", "error");
      }
    }
  };

  return (
    <div>
      <SectionHeader title="Investigation Reports" sub="Generate and export a structured report for a selected actor." crumbs={["UMBRA", "Investigation Reports"]} right={<DemoTag />} />
      <div className="mb-4 flex flex-wrap items-center gap-2">
        <span className="text-[12px] text-slate-500">Actor:</span>
        <select value={actorId} onChange={e => setActorId(e.target.value)} className="rounded border border-slate-800 bg-slate-900 px-2 py-1.5 text-[12px] text-slate-300">
          {DATA.actors.map(a => <option key={a.id} value={a.id}>{a.primaryAlias}</option>)}
        </select>
        {TLP_OPTS.map(o => (
          <button key={o.id} onClick={() => setTlp(o.id)} className={`rounded border px-2 py-1.5 text-[11px] font-mono font-medium ${tlp === o.id ? o.color + " bg-slate-800/60" : "border-slate-800 text-slate-600"}`}>TLP:{o.id}</button>
        ))}
        <label className="flex items-center gap-1.5 text-[11px] text-slate-400"><input type="checkbox" checked={redact} onChange={e => setRedact(e.target.checked)} /> Redact for sharing</label>
        <div className="ml-auto flex flex-wrap gap-2">
          <button onClick={downloadJSON} className="flex items-center gap-1 rounded border border-slate-800 px-2.5 py-1.5 text-[12px] text-slate-300 hover:border-slate-600"><FileJson size={13} /> Export JSON</button>
          <button onClick={downloadCSV} className="flex items-center gap-1 rounded border border-slate-800 px-2.5 py-1.5 text-[12px] text-slate-300 hover:border-slate-600"><FileSpreadsheet size={13} /> Export CSV</button>
          <button onClick={downloadStix} disabled={!stix} className="flex items-center gap-1 rounded border border-violet-500/30 bg-violet-500/10 px-2.5 py-1.5 text-[12px] text-violet-300 hover:bg-violet-500/20 disabled:opacity-50"><GitCompare size={13} /> {buildingStix ? "Hashing…" : "Export STIX"}</button>
          <button onClick={printReport} className="flex items-center gap-1 rounded bg-cyan-500/15 border border-cyan-500/30 px-2.5 py-1.5 text-[12px] text-cyan-300 hover:bg-cyan-500/25"><Printer size={13} /> Print / PDF</button>
        </div>
      </div>

      <div id="report-print" ref={printRef} className="space-y-4 rounded-lg border border-slate-800 bg-slate-900/60 p-6">
        <div className="flex items-center justify-between border-b border-slate-800 pb-3">
          <div>
            <div className="text-[11px] font-mono text-slate-500">{reportObj.reportId} · TLP:{tlp}</div>
            <h2 className="text-lg font-semibold text-slate-100">Investigation Report — {actor.primaryAlias}</h2>
          </div>
          <DemoTag />
        </div>
        <ReportSection title="1. Executive Summary"><p className="text-[13px] text-slate-300">{reportObj.executiveSummary}</p></ReportSection>
        <ReportSection title="2. Actor Profile">
          <div className="grid grid-cols-2 gap-2 text-[12px] sm:grid-cols-4">
            <Row label="ID" value={actor.id} /><Row label="Category" value={actor.category} /><Row label="First Seen" value={actor.firstSeen} /><Row label="Last Seen" value={actor.lastSeen} />
          </div>
        </ReportSection>
        <ReportSection title="3. Known Aliases"><div className="flex flex-wrap gap-1.5">{actor.aliases.map(a => <span key={a} className="rounded border border-slate-700 px-2 py-0.5 font-mono text-[11px]">{a}</span>)}</div></ReportSection>
        <ReportSection title="4. Infrastructure Findings">
          {infra.map(i => <p key={i.id} className="text-[12px] text-slate-400 font-mono">{mask(i.domain)} · {mask(i.ip)} · {mask(i.certFingerprint)}</p>)}
        </ReportSection>
        <ReportSection title="5. Identifier Correlations">
          {rels.filter(r => ["SAME_HANDLE", "SHARED_PGP", "SHARED_WALLET"].includes(r.type)).map(r => <p key={r.id} className="text-[12px] text-slate-400">{r.type}: {r.reason}</p>)}
        </ReportSection>
        <ReportSection title="6. Persona Analysis">
          {persona.map(p => <p key={p.id} className="text-[12px] text-slate-400">{p.aliasA} ↔ {p.aliasB}: {p.similarity}% similarity</p>)}
        </ReportSection>
        <ReportSection title="7. Relationship Analysis">
          {rels.map(r => <p key={r.id} className="text-[12px] text-slate-400">{r.type} → {actorById(r.source === actorId ? r.target : r.source).primaryAlias} ({r.confidence}%, FP risk {r.falsePositiveRisk})</p>)}
        </ReportSection>
        <ReportSection title="8. Evidence">{ev.map(e => <p key={e.id} className="text-[12px] text-slate-400 font-mono">{e.id} — {e.description}</p>)}</ReportSection>
        <ReportSection title="9. Timeline">{tl.map(t => <p key={t.id} className="text-[12px] text-slate-400">{t.timestamp} — {t.description}</p>)}</ReportSection>
        <ReportSection title="10. Attribution Assessment"><p className="text-[13px] text-slate-300">Overall confidence {attr.overall}% (Infrastructure {attr.infrastructure}%, Identifier {attr.identifier}%, PGP {attr.pgp}%, Wallet {attr.wallet}%, Persona {attr.persona}%, Behavioral {attr.behavioral}%)</p></ReportSection>
        <ReportSection title="11. Confidence"><ConfidenceBadge value={attr.overall} /></ReportSection>
        <ReportSection title="12. False Positive Considerations">
          {reportObj.falsePositiveConsiderations.length ? reportObj.falsePositiveConsiderations.map((f, i) => <p key={i} className="text-[12px] text-amber-300">{f}</p>) : <p className="text-[12px] text-slate-500">No significant false-positive concerns flagged.</p>}
        </ReportSection>
        <ReportSection title="13. Analyst Notes"><p className="text-[12px] text-slate-400">{reportObj.analystNotes}</p></ReportSection>
        {redact && (tlp === "RED" || tlp === "AMBER+STRICT") && <p className="text-[10px] text-amber-500">Identifiers above are redacted for TLP:{tlp} sharing. Full values remain in the source record.</p>}
      </div>

      <div className="mt-4">
        <div className="mb-2 text-sm font-medium text-slate-200">Actor Comparison</div>
        <ActorComparison />
      </div>
    </div>
  );
}
