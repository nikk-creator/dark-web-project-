function InfrastructureLens({ actorId, setActorId }) {
  if (DATA.infrastructure.length === 0) {
    return (
      <div>
        <SectionHeader title="Infrastructure Lens" sub="Trace hidden-service indicators to potential clearnet infrastructure." crumbs={["UMBRA", "Infrastructure Lens"]} right={<DemoTag />} />
        <EmptyState icon={Server} title="No infrastructure indicators yet" sub="Add an actor with a domain or IP via Intelligence Intake to see correlation analysis here." />
      </div>
    );
  }
  const infra = infraForActor(actorId || DATA.infrastructure[0].actorId)[0] || DATA.infrastructure[0];
  const actor = actorById(infra.actorId);
  // pick a "correlated" comparison actor deterministically
  const correlatedIdx = (DATA.actors.findIndex(a => a.id === infra.actorId) + 1) % DATA.actors.length;
  const correlated = infraForActor(DATA.actors[correlatedIdx].id)[0] || infra;
  const correlatedActor = actorById(correlated.actorId);

  const matches = [
    { label: "HTTP Server", a: infra.httpServer, b: correlated.httpServer },
    { label: "Certificate Issuer", a: infra.certIssuer, b: correlated.certIssuer },
    { label: "Certificate Fingerprint", a: infra.certFingerprint, b: correlated.certFingerprint },
    { label: "Nameserver Pattern", a: infra.ns, b: correlated.ns },
    { label: "Technology Stack", a: infra.techStack, b: correlated.techStack },
    { label: "Hosting Provider", a: infra.host, b: correlated.host },
  ];
  const matchCount = matches.filter(m => m.a === m.b).length;
  const partialCount = matches.filter(m => m.a !== m.b && (m.a.split(" ")[0] === m.b.split(" ")[0])).length;
  const score = Math.round((matchCount * 100 + partialCount * 50) / matches.length);
  const conf = score >= 75 ? "High" : score >= 50 ? "Medium" : "Low";

  return (
    <div>
      <SectionHeader title="Infrastructure Lens" sub="Trace hidden-service indicators to potential clearnet infrastructure." crumbs={["UMBRA", "Infrastructure Lens"]} right={<DemoTag />} />
      <div className="mb-3 flex items-center gap-2">
