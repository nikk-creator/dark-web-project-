          {DATA.actors.map(a => <option key={a.id} value={a.id}>{a.primaryAlias}</option>)}
        </select>
      </div>

      <div className="mb-4 rounded-lg border border-slate-800 bg-slate-900/60 p-4">
        <div className="mb-3 text-[11px] font-medium uppercase tracking-wide text-slate-500">Investigation chain</div>
        <div className="flex flex-wrap items-center gap-2 text-[12px]">
          {["Threat Actor", "Handle", "Hidden-Service Identifier", "Infrastructure Indicator", "Certificate / HTTP / DNS Metadata", "Potential Clearnet Infrastructure"].map((step, i, arr) => (
            <React.Fragment key={step}>
              <span className="rounded border border-slate-700 bg-slate-800/50 px-2 py-1 text-slate-300">{step}</span>
              {i < arr.length - 1 && <ChevronRight size={13} className="text-slate-600" />}
            </React.Fragment>
          ))}
        </div>
        <p className="mt-2 text-[12px] text-slate-500 font-mono">{actor?.primaryAlias} → {actor?.aliases[0]} → {infra.domain} (Tor mirror) → {infra.ip} → {infra.certFingerprint} → possible clearnet host at {infra.host}</p>
      </div>

      <div className="grid grid-cols-1 gap-3 lg:grid-cols-2">
        <div className="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
          <div className="mb-2 text-sm font-medium text-slate-200">Technical indicators — {infra.id}</div>
          <div className="space-y-2 text-[12px]">
            <Row label="IP" value={<span className="font-mono">{infra.ip}</span>} />
            <Row label="ASN" value={infra.asn} />
            <Row label="Port" value={infra.port} />
            <Row label="Domain" value={<span className="font-mono">{infra.domain}</span>} />
            <Row label="Nameserver" value={<span className="font-mono">{infra.ns}</span>} />
            <Row label="TLS Certificate Issuer" value={infra.certIssuer} />
            <Row label="Certificate Fingerprint" value={<span className="font-mono text-[11px]">{infra.certFingerprint}</span>} />
