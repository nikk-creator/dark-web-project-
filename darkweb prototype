/* ---------------------------- Dataset generation ---------------------------- */
function buildDataset() {
  const actors = [];
  const aliases = [];
  const pgpKeys = [];
  const wallets = [];
  const infrastructure = [];
  const evidence = [];
  const relationships = [];
  const timelineEvents = [];
  const personaAnalysis = [];

  let evCounter = 1;
  const newEvidence = (type, actorId, desc, daysAgo, reliability) => {
    const id = `EVD-${pad(evCounter++, 4)}`;
    evidence.push({
      id, type, source: pick(SOURCES).name, actorId,
      observedAt: dateStr(daysAgo + randInt(0, 2)),
      collectedAt: dateStr(daysAgo),
      reliability: reliability || pick(["A", "A", "B", "B", "C"]),
      confidence: randInt(55, 97),
      hash: "sha256:" + hex(24).toLowerCase(),
      description: desc,
    });
    return id;
  };

  const ACTOR_COUNT = 26;
  for (let i = 1; i <= ACTOR_COUNT; i++) {
    const id = `ACT-${pad(i, 4)}`;
    const primaryAlias = genHandle();
    const aliasCount = randInt(2, 5);
    const actorAliases = [primaryAlias, ...Array.from({ length: aliasCount - 1 }, genHandle)];
    const category = pick(CATEGORIES);
    const firstSeenDays = randInt(200, 900);
    const lastSeenDays = randInt(0, 60);
    const riskLevel = pick(RISK_LEVELS);
    const status = pick(STATUSES);

    actors.push({
      id, primaryAlias, aliases: actorAliases, category,
      firstSeen: dateStr(firstSeenDays), lastSeen: dateStr(lastSeenDays),
      riskLevel, status, notes: null,
    });

    actorAliases.forEach((a, idx) => aliases.push({
      actorId: id, alias: a, isPrimary: idx === 0,
      firstSeen: dateStr(firstSeenDays - idx * randInt(5, 40)),
      forum: pick(["Obscura Board", "Nightbazaar (mirror)", "Ledger Exchange Forum", "Vellum Market", "Hush Relay"]),
    }));

    // identifiers
    const pgpId = `PGP-${pad(i, 3)}`;
    pgpKeys.push({ id: pgpId, actorId: id, fingerprint: hex(4) + " " + hex(4) + " " + hex(4) + " " + hex(4), firstSeen: dateStr(firstSeenDays - 10) });
    const walletId = `WLT-${pad(i, 3)}`;
    wallets.push({ id: walletId, actorId: id, chain: pick(["BTC", "XMR", "ETH"]), address: (pick(["bc1q", "4A", "0x"]) + hex(20)).slice(0, 30), firstSeen: dateStr(firstSeenDays - 5) });

    // infrastructure
    const domain = `${primaryAlias.toLowerCase().replace(/[^a-z0-9]/g, "")}${randInt(1, 999)}${pick(TLDs)}`;
    const ip = `${randInt(45, 199)}.${randInt(0, 255)}.${randInt(0, 255)}.${randInt(1, 254)}`;
    const certFp = hex(2) + ":" + hex(2) + ":" + hex(2) + ":" + hex(2) + ":" + hex(2) + ":" + hex(2);
    const infraId = `INF-${pad(i, 4)}`;
    infrastructure.push({
      id: infraId, actorId: id, domain, ip, asn: `AS${randInt(10000, 65000)}`,
      port: pick([443, 8443, 443, 443]), host: pick(HOSTS), ns: `ns${randInt(1, 3)}.${pick(HOSTS).toLowerCase().replace(/\s+/g, "")}.net`,
      httpServer: pick(SERVERS), techStack: pick(TECH_STACKS),
      certIssuer: pick(CERT_ISSUERS), certFingerprint: certFp,
      firstSeen: dateStr(firstSeenDays - 15), lastSeen: dateStr(lastSeenDays),
    });

    // evidence tied to this actor's core identifiers
    const e1 = newEvidence("Handle", id, `Alias "${primaryAlias}" observed posting on ${aliases[aliases.length - 1].forum}.`, lastSeenDays + 3);
    const e2 = newEvidence("PGP", id, `PGP fingerprint ${pgpKeys[pgpKeys.length - 1].fingerprint} published in vendor profile for "${primaryAlias}".`, lastSeenDays + 8);
    const e3 = newEvidence("Infrastructure", id, `TLS certificate (fingerprint ${certFp}) observed on hidden-service mirror linked to "${primaryAlias}".`, lastSeenDays + 12);

    timelineEvents.push({ id: `EVT-${pad(i, 4)}a`, actorId: id, type: "Alias Observed", description: `Alias "${primaryAlias}" first logged in current monitoring window.`, timestamp: dateTimeStr(lastSeenDays + 3, randInt(0, 23), randInt(0, 59)), source: pick(SOURCES).name, confidence: randInt(60, 90), evidenceId: e1 });
    timelineEvents.push({ id: `EVT-${pad(i, 4)}b`, actorId: id, type: "Identifier Associated", description: `New PGP identifier associated with "${primaryAlias}".`, timestamp: dateTimeStr(lastSeenDays + 8, randInt(0, 23), randInt(0, 59)), source: pick(SOURCES).name, confidence: randInt(60, 92), evidenceId: e2 });
    timelineEvents.push({ id: `EVT-${pad(i, 4)}c`, actorId: id, type: "Infrastructure Indicator Discovered", description: `Certificate fingerprint recorded for infrastructure linked to "${primaryAlias}".`, timestamp: dateTimeStr(lastSeenDays + 12, randInt(0, 23), randInt(0, 59)), source: pick(SOURCES).name, confidence: randInt(55, 88), evidenceId: e3 });
  }

  /* ---- Deliberate cross-links for a convincing graph + false positives ---- */
  const link = (aIdx, bIdx, type, confidence, reasonFn, falsePositiveRisk, evDesc) => {
    const a = actors[aIdx], b = actors[bIdx];
    const evId = newEvidence(type, a.id, evDesc, randInt(5, 40));
    relationships.push({
      id: `REL-${pad(relationships.length + 1, 4)}`,
      source: a.id, target: b.id, type, confidence,
      falsePositiveRisk, evidenceId: evId,
      reason: reasonFn(a, b),
    });
  };

  // Strong attribution chain: 0 <-> 1 (shared PGP + shared infra + cert)
  link(0, 1, "SHARED_PGP", 92, (a, b) => `The same PGP fingerprint was observed in independent records associated with "${a.primaryAlias}" and "${b.primaryAlias}".`, "Low", `PGP fingerprint match between vendor profiles of "${actors[0].primaryAlias}" and "${actors[1].primaryAlias}".`);
  link(0, 1, "SAME_CERTIFICATE", 88, (a, b) => `Identical TLS certificate fingerprint observed on infrastructure serving both "${a.primaryAlias}" and "${b.primaryAlias}".`, "Low", "Certificate fingerprint reuse across two hidden-service mirrors.");
  link(0, 1, "SIMILAR_WRITING_STYLE", 84, (a, b) => `Stylometric comparison of forum posts attributed to "${a.primaryAlias}" and "${b.primaryAlias}" shows high similarity across vocabulary, sentence structure and phrase usage.`, "Medium", "Persona Analysis module flagged high writing-style similarity.");

  // Medium attribution: 2 <-> 3 (shared infra only — provider-level, higher FP risk)
  link(2, 3, "SHARED_INFRASTRUCTURE", 61, (a, b) => `"${a.primaryAlias}" and "${b.primaryAlias}" both operate infrastructure hosted with the same provider and nameserver pattern.`, "Medium", "Shared hosting provider and nameserver pattern observed across two unrelated-looking storefronts.");

  // Weak / false-positive scenario: 4 <-> 5 (shared wallet cluster, common among unrelated actors)
  link(4, 5, "SHARED_WALLET", 38, (a, b) => `Wallet cluster analysis shows "${a.primaryAlias}" and "${b.primaryAlias}" transacting through addresses in the same clustering group.`, "High", "Shared wallet cluster — mixing services routinely group unrelated actors into common clusters, so this alone is weak evidence.");

  // Conflicting evidence: 6 <-> 7 (style match but infra differs entirely)
  link(6, 7, "SIMILAR_WRITING_STYLE", 71, (a, b) => `Writing-style similarity between "${a.primaryAlias}" and "${b.primaryAlias}" is notable, but infrastructure and identifiers do not corroborate.`, "High", "Persona similarity flagged, but infrastructure indicators point to different hosting entirely — contradictory signal.");

  // Rebrand / migration chain: 8 -> 9 -> 10 (SAME_HANDLE variants + persona)
  link(8, 9, "SAME_HANDLE", 79, (a, b) => `"${b.primaryAlias}" reuses a handle fragment and vendor bio text nearly identical to "${a.primaryAlias}", consistent with a marketplace migration.`, "Medium", "Near-identical vendor bio and handle fragment reused after marketplace closure.");
  link(9, 10, "COMMON_CONTACT", 66, (a, b) => `"${a.primaryAlias}" and "${b.primaryAlias}" list the same escrow contact handle in vendor profiles.`, "Medium", "Shared escrow/contact handle listed in two separate vendor profiles.");

  // Additional organic-looking relationships for graph density
  for (let n = 0; n < 30; n++) {
    const i = randInt(0, ACTOR_COUNT - 1);
    let j = randInt(0, ACTOR_COUNT - 1);
    while (j === i) j = randInt(0, ACTOR_COUNT - 1);
    const type = pick(REL_TYPES.filter(t => !["POSTED_ON", "RESOLVES_TO"].includes(t)));
    const conf = randInt(35, 95);
    link(i, j, type, conf, (a, b) => {
      const map = {
        SAME_HANDLE: `Handle fragment overlap detected between "${a.primaryAlias}" and "${b.primaryAlias}".`,
        SHARED_PGP: `A PGP sub-key relationship links "${a.primaryAlias}" and "${b.primaryAlias}".`,
        SHARED_WALLET: `Overlapping wallet cluster membership between "${a.primaryAlias}" and "${b.primaryAlias}".`,
        SHARED_INFRASTRUCTURE: `Shared hosting footprint between "${a.primaryAlias}" and "${b.primaryAlias}".`,
        SAME_CERTIFICATE: `Certificate reuse observed between infrastructure of "${a.primaryAlias}" and "${b.primaryAlias}".`,
        SAME_IP: `Both actors' hidden services resolved through the same clearnet IP at different times.`,
        SIMILAR_WRITING_STYLE: `Stylometric overlap between posts of "${a.primaryAlias}" and "${b.primaryAlias}".`,
        COMMON_CONTACT: `Shared third-party contact identifier between "${a.primaryAlias}" and "${b.primaryAlias}".`,
        ASSOCIATED_WITH: `General co-occurrence pattern linking "${a.primaryAlias}" and "${b.primaryAlias}" across two sources.`,
      };
      return map[type] || `Correlated indicator linking "${a.primaryAlias}" and "${b.primaryAlias}".`;
    }, conf > 70 ? "Low" : conf > 50 ? "Medium" : "High", "Automated correlation pass flagged overlapping indicator during routine ingestion.");
  }

  /* ---- Persona analysis samples ---- */
  const genPassage = (seedPhrase) => {
    const openers = ["Listen up —", "Quick note:", "As always,", "For the record,", "Heads up,"];
    const closers = ["Stay safe out there.", "You know the drill.", "That's all for now.", "More soon.", "Keep it tight."];
    return `${pick(openers)} ${seedPhrase}. ${pick(PHRASES)}. ${pick(PHRASES)}. ${pick(closers)}`;
  };
  const personaPairs = [[0, 1], [2, 3], [6, 7], [8, 9], [11, 12], [13, 14], [15, 16]];
  personaPairs.forEach(([i, j], idx) => {
    const a = actors[i], b = actors[j];
    const shared = pick(PHRASES);
    const vocab = randInt(55, 95), sentence = randInt(55, 95), phrase = randInt(45, 90), posting = randInt(50, 95);
    const similarity = Math.round((vocab + sentence + phrase + posting) / 4);
    personaAnalysis.push({
      id: `PSA-${pad(idx + 1, 3)}`,
      actorA: a.id, aliasA: a.primaryAlias,
      actorB: b.id, aliasB: b.primaryAlias,
      similarity, vocab, sentence, phrase, posting,
      sampleA: genPassage(`the ${shared} policy stands`),
      sampleB: genPassage(`we still run on ${shared}`),
      postingWindowA: `${randInt(0, 12)}:00–${randInt(13, 23)}:00 UTC`,
      postingWindowB: `${randInt(0, 12)}:00–${randInt(13, 23)}:00 UTC`,
    });
  });

  return { actors, aliases, pgpKeys, wallets, infrastructure, evidence, relationships, timelineEvents, personaAnalysis, sources: SOURCES };
}

// Starts genuinely empty — matching the real backend's default (npm run
// setup, not setup:demo). buildDataset() above is never called, so no
// synthetic actors/evidence/relationships exist. Only the static reference
// catalog (SOURCES, WEIGHTS, both plain constants defined by the generator
// above) is present. Everything populates only from what you provide via
// Intelligence Intake, exactly like the real backend.
let DATA = {
  actors: [], aliases: [], pgpKeys: [], wallets: [], infrastructure: [],
  evidence: [], relationships: [], timelineEvents: [], personaAnalysis: [],
  sources: SOURCES, hypotheses: [],
};

// In-memory chain-of-custody + team-review logs (mirror the audit_log / reviews tables).
let AUDIT_LOG = {};
let REVIEWS = {};
let _nextReviewId = 1;

/* ---------------------------- Live shared case file (window.storage) ----------------------------
   Real persistence layer: every mutation below is written to a single shared
   storage key, so the case file survives a refresh and is shared live across
   every tab/session with this artifact open — the closest thing to a real
   database this sandbox can offer. A lightweight poll (see useLiveSync)
   detects when another session has written new data and merges it in,
   driving the same pulse-on-arrival + auto-refresh path that was originally
   wired for a Socket.IO push. */
const CASE_KEY = "umbra:case-file";
let DATA_VERSION = 0;
let LAST_SYNCED_AT = null; // epoch ms of the most recent successful read/write
let SYNC_STATE = "connecting"; // "connecting" | "live" | "local"
let _syncListeners = [];
function notifySync() { _syncListeners.forEach((fn) => fn()); }
function useLiveSyncStatus() {
  const [, force] = useState(0);
  useEffect(() => {
    const listener = () => force((x) => x + 1);
    _syncListeners.push(listener);
    return () => { _syncListeners = _syncListeners.filter((l) => l !== listener); };
  }, []);
  return { syncState: SYNC_STATE, lastSyncedAt: LAST_SYNCED_AT, version: DATA_VERSION };
}
function snapshotState() {
  return JSON.stringify({ DATA, AUDIT_LOG, REVIEWS, _nextReviewId, version: DATA_VERSION });
}
function hydrateFrom(json) {
  const parsed = JSON.parse(json);
  DATA = parsed.DATA || DATA;
  AUDIT_LOG = parsed.AUDIT_LOG || {};
  REVIEWS = parsed.REVIEWS || {};
  _nextReviewId = parsed._nextReviewId || 1;
  DATA_VERSION = parsed.version || 0;
}
// Call after any local mutation. Bumps the version, writes the whole case
// file to shared storage, and pings any subscribed UI (sidebar/header status,
// the network graph's pulse effect) that something changed.
async function persistState() {
  DATA_VERSION += 1;
  if (typeof window === "undefined" || !window.storage) { SYNC_STATE = "local"; notifySync(); return; }
  try {
    const result = await window.storage.set(CASE_KEY, snapshotState(), true);
    if (result) { SYNC_STATE = "live"; LAST_SYNCED_AT = Date.now(); }
    else { SYNC_STATE = "local"; }
  } catch (e) {
    SYNC_STATE = "local";
  }
  notifySync();
}
// Pulls the shared case file down. Returns the set of actor ids that are new
// since our last known version (for the "just arrived" pulse ring) or null
// if nothing changed.
async function pullRemoteState() {
  if (typeof window === "undefined" || !window.storage) { SYNC_STATE = "local"; notifySync(); return null; }
  try {
    const result = await window.storage.get(CASE_KEY, true);
    if (!result || !result.value) { SYNC_STATE = "live"; LAST_SYNCED_AT = Date.now(); notifySync(); return null; }
    const parsed = JSON.parse(result.value);
    SYNC_STATE = "live";
    LAST_SYNCED_AT = Date.now();
    if ((parsed.version || 0) <= DATA_VERSION) { notifySync(); return null; }
    const priorActorIds = new Set(DATA.actors.map((a) => a.id));
    hydrateFrom(result.value);
    const newIds = DATA.actors.filter((a) => !priorActorIds.has(a.id)).map((a) => a.id);
    notifySync();
    return newIds;
  } catch (e) {
    SYNC_STATE = "local";
    notifySync();
    return null;
  }
}

const TODAY = new Date().toISOString().slice(0, 10);
const ANALYSTS = [{ name: "Priya K.", role: "Lead analyst" }, { name: "Owen T.", role: "Peer reviewer" }];

function daysBetween(d1, d2) {
  if (!d1) return 0;
  return Math.max(0, Math.round((new Date(d2) - new Date(d1)) / 86400000));
}
// Evidence not reconfirmed within 30 days starts losing weight, floored at 35%.
function decayFactor(days) {
  if (days <= 30) return 1;
  return Math.max(0.35, 1 - (days - 30) / 260);
}
function evidenceForRel(rel) { return DATA.evidence.find(e => e.id === rel.evidenceId); }
// A relationship's confidence as actually used in scoring — the raw stored
// value discounted by how stale its supporting evidence is.
function effectiveConfidence(rel) {
  const ev = evidenceForRel(rel);
  if (!ev) return rel.confidence;
  const days = daysBetween(ev.lastConfirmed || ev.observedAt, TODAY);
  return rel.confidence * decayFactor(days);
}

async function sha256Hex(str) {
  try {
    if (window.crypto && window.crypto.subtle) {
      const buf = await window.crypto.subtle.digest("SHA-256", new TextEncoder().encode(str));
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, "0")).join("");
    }
  } catch (e) { /* fall through */ }
  return null;
}

// On startup, pull whatever is already in the shared case file (another tab
// or a prior session may have put real data there) before falling back to
// the empty default. This is what makes the case file survive a refresh.
async function loadData() {
  if (typeof window === "undefined" || !window.storage) { SYNC_STATE = "local"; return DATA; }
  try {
    const result = await window.storage.get(CASE_KEY, true);
    if (result && result.value) hydrateFrom(result.value);
    SYNC_STATE = "live";
    LAST_SYNCED_AT = Date.now();
  } catch (e) {
    // Nothing saved yet under this key — seed it so future sessions (and
    // other tabs) have something to read.
    SYNC_STATE = "live";
    try { await window.storage.set(CASE_KEY, snapshotState(), true); LAST_SYNCED_AT = Date.now(); }
    catch (e2) { SYNC_STATE = "local"; }
  }
  return DATA;
}

// Real mutation, not a stats-only simulation: this actually creates actors,
// identifiers, infrastructure, evidence, relationships, persona pairs and
// timeline events in DATA, checking for true duplicates. Tracks
// createdActorIds (matching the real backend's response shape) so the
// Intelligence Intake results view can show real, clickable actor cards.
//
// Recognized record fields (all optional besides handle/alias):
//   handle | alias           — the actor's primary alias (required)
//   category                 — one of CATEGORIES
//   riskLevel                — one of RISK_LEVELS
//   status                   — one of STATUSES
//   pgp, wallet, walletChain, domain, ip, note
//   firstSeenDaysAgo, lastSeenDaysAgo — ints, spread activity over time
//   confidence, reliability  — this record's own evidence item
//   linkTo, linkType, linkConfidence, linkFpRisk
//     — creates a relationship to another handle in this same upload
//       (resolved after every actor in the batch exists, so link order
//       doesn't matter, and it can also point at an actor from an earlier
//       upload already in the case file)
//   personaWith, personaSimilarity — creates a Persona Analysis pair
const numOrDefault = (v, dflt) => {
  if (v === undefined || v === null || v === "") return dflt;
  const n = Number(v);
  return Number.isFinite(n) ? n : dflt;
};
async function submitIntake(records, sourceLabel, analyst) {
  let valid = 0, entities = 0, relCreated = 0, personaCreated = 0, dupes = 0, warnings = 0, errors = 0;
  const createdActorIds = [];
  // Seed from everything already on file so cross-upload linkTo/personaWith
  // references (and duplicate checks) work, not just within this batch.
  const handleMap = new Map(DATA.aliases.map(a => [a.alias.toLowerCase(), a.actorId]));

  records.forEach(r => {
    const keys = Object.keys(r || {});
    if (!keys.length) { errors++; return; }
    valid++;
    const handle = r.handle || r.alias;
    if (!handle) { warnings++; return; }
    if (handleMap.has(String(handle).toLowerCase())) { dupes++; return; }

    const newId = `ACT-${pad(DATA.actors.length + 1, 4)}`;
    const category = CATEGORIES.includes(r.category) ? r.category : "Other";
    const riskLevel = RISK_LEVELS.includes(r.riskLevel) ? r.riskLevel : "Low";
    const status = STATUSES.includes(r.status) ? r.status : "MONITORING";
    const firstSeenDays = numOrDefault(r.firstSeenDaysAgo, randInt(30, 400));
    const lastSeenDays = numOrDefault(r.lastSeenDaysAgo, randInt(0, 45));
    const firstSeen = dateStr(firstSeenDays);
    const lastSeen = dateStr(lastSeenDays);

    DATA.actors.push({ id: newId, primaryAlias: handle, aliases: [handle], category, firstSeen, lastSeen, riskLevel, status, notes: r.note || null });
    DATA.aliases.push({ actorId: newId, alias: handle, isPrimary: true, firstSeen, forum: sourceLabel });
    handleMap.set(String(handle).toLowerCase(), newId);
    entities++;

    if (r.pgp) { DATA.pgpKeys.push({ id: `PGP-${pad(DATA.pgpKeys.length + 1, 3)}`, actorId: newId, fingerprint: r.pgp, firstSeen }); entities++; }
    if (r.wallet) {
      const chain = r.walletChain || (String(r.wallet).startsWith("0x") ? "ETH" : String(r.wallet).startsWith("bc1") ? "BTC" : "XMR");
      DATA.wallets.push({ id: `WLT-${pad(DATA.wallets.length + 1, 3)}`, actorId: newId, chain, address: r.wallet, firstSeen });
      entities++;
    }
    if (r.domain || r.ip) {
      // Auto-fill the fields Infrastructure Lens compares (host, cert,
      // stack, nameserver) so uploaded actors work there too, not just
      // ones from the built-in generator.
      DATA.infrastructure.push({
        id: `INF-${pad(DATA.infrastructure.length + 1, 4)}`, actorId: newId,
        domain: r.domain || null, ip: r.ip || null, asn: `AS${randInt(10000, 65000)}`,
        port: pick([443, 8443, 443]), host: pick(HOSTS),
        ns: `ns${randInt(1, 3)}.${pick(HOSTS).toLowerCase().replace(/\s+/g, "")}.net`,
        httpServer: pick(SERVERS), techStack: pick(TECH_STACKS), certIssuer: pick(CERT_ISSUERS),
        certFingerprint: hex(2) + ":" + hex(2) + ":" + hex(2) + ":" + hex(2) + ":" + hex(2) + ":" + hex(2),
        firstSeen, lastSeen,
      });
      entities++;
    }

    const evId = `EVD-${pad(DATA.evidence.length + 1, 4)}`;
    const reliability = ["A", "B", "C", "D", "E"].includes(r.reliability) ? r.reliability : pick(["A", "B", "B", "C", "C", "D", "E"]);
    const confidence = numOrDefault(r.confidence, randInt(55, 95));
    DATA.evidence.push({ id: evId, type: "Intake", source: sourceLabel, actorId: newId, observedAt: lastSeen, collectedAt: TODAY, lastConfirmed: TODAY, reliability, confidence, hash: "sha256:" + hex(24).toLowerCase(), description: `Record ingested via Intelligence Intake: ${JSON.stringify(r)}` });
    AUDIT_LOG[evId] = [{ id: `${evId}-a1`, evidenceId: evId, analyst: analyst || "Unknown analyst", action: "Evidence ingested", createdAt: new Date().toISOString() }];
    DATA.hypotheses.push({ id: `HYP-${newId}`, actorId: newId, label: "Primary attribution", note: null, isPrimary: true, includedRelationshipIds: [] });
    DATA.timelineEvents.push({
      id: `EVT-${newId}-a`, actorId: newId, type: "Alias Observed",
      description: `Alias "${handle}" ingested via ${sourceLabel}.`,
      timestamp: dateTimeStr(lastSeenDays, randInt(0, 23), randInt(0, 59)),
      source: sourceLabel, confidence, evidenceId: evId,
    });
    createdActorIds.push(newId);
  });

  // Second pass: relationships and persona pairs, resolved against the full
  // handle map — this batch plus anything already in the case file — so
  // link order within the file never matters.
  records.forEach(r => {
    const handle = r.handle || r.alias;
    if (!handle) return;
    const sourceId = handleMap.get(String(handle).toLowerCase());
    if (!sourceId) return;

    if (r.linkTo) {
      const targetId = handleMap.get(String(r.linkTo).toLowerCase());
      if (targetId && targetId !== sourceId) {
        const type = REL_TYPES.includes(r.linkType) ? r.linkType : pick(REL_TYPES);
        const confidence = numOrDefault(r.linkConfidence, randInt(35, 95));
        const fpRisk = ["Low", "Medium", "High"].includes(r.linkFpRisk) ? r.linkFpRisk : (confidence > 70 ? "Low" : confidence > 50 ? "Medium" : "High");
        const targetAlias = actorById(targetId)?.primaryAlias || r.linkTo;
        const evId = `EVD-${pad(DATA.evidence.length + 1, 4)}`;
        const reason = `Correlation ingested via Intelligence Intake linking "${handle}" and "${targetAlias}" (${type.replace(/_/g, " ").toLowerCase()}).`;
        DATA.evidence.push({ id: evId, type: "Correlation", source: sourceLabel, actorId: sourceId, observedAt: TODAY, collectedAt: TODAY, lastConfirmed: TODAY, reliability: pick(["A", "B", "C"]), confidence, hash: "sha256:" + hex(24).toLowerCase(), description: reason });
        AUDIT_LOG[evId] = [{ id: `${evId}-a1`, evidenceId: evId, analyst: analyst || "Unknown analyst", action: "Evidence ingested", createdAt: new Date().toISOString() }];
        const relId = `REL-${pad(DATA.relationships.length + 1, 4)}`;
        DATA.relationships.push({ id: relId, source: sourceId, target: targetId, type, confidence, falsePositiveRisk: fpRisk, evidenceId: evId, reason });
        DATA.timelineEvents.push({ id: `EVT-${relId}`, actorId: sourceId, type: "Identifier Associated", description: reason, timestamp: dateTimeStr(0, randInt(0, 23), randInt(0, 59)), source: sourceLabel, confidence, evidenceId: evId });
        relCreated++;
      }
    }

    if (r.personaWith) {
      const targetId = handleMap.get(String(r.personaWith).toLowerCase());
      if (targetId && targetId !== sourceId) {
        const similarity = numOrDefault(r.personaSimilarity, randInt(45, 95));
        const jitter = () => Math.max(0, Math.min(100, similarity + randInt(-10, 10)));
        const targetAlias = actorById(targetId)?.primaryAlias || r.personaWith;
        DATA.personaAnalysis.push({
          id: `PSA-${pad(DATA.personaAnalysis.length + 1, 3)}`,
          actorA: sourceId, aliasA: handle, actorB: targetId, aliasB: targetAlias,
          similarity, vocab: jitter(), sentence: jitter(), phrase: jitter(), posting: jitter(),
          sampleA: `Posts attributed to "${handle}", ingested via ${sourceLabel}.`,
          sampleB: `Posts attributed to "${targetAlias}", ingested via ${sourceLabel}.`,
          postingWindowA: `${randInt(0, 12)}:00–${randInt(13, 23)}:00 UTC`,
          postingWindowB: `${randInt(0, 12)}:00–${randInt(13, 23)}:00 UTC`,
        });
        personaCreated++;
      }
    }
  });

  const stats = { received: records.length, valid, entities, relCreated, personaCreated, dupes, warnings, errors, createdActorIds };
  if (entities > 0) {
    await persistState();
    const extra = [relCreated ? `${relCreated} relationship${relCreated === 1 ? "" : "s"}` : null, personaCreated ? `${personaCreated} persona match${personaCreated === 1 ? "" : "es"}` : null].filter(Boolean).join(", ");
    notifyToast(`${entities} entit${entities === 1 ? "y" : "ies"} created from ${sourceLabel}${extra ? `, ${extra}` : ""} — saved to the shared case file`, "success");
  } else if (dupes > 0) notifyToast(`No new entities — ${dupes} duplicate(s) skipped`, "info");
  return stats;
}

// Client-side mirror of server.js's parseRawLog + ingestRecords — same
// regex extraction (IPv4, .onion v3, explicit handle markers), same record
// shape, so this behaves identically to the real backend's raw-log endpoint.
function parseRawLog(text) {
  const ipRe = /\b(?:(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\b/g;
  const onionRe = /\b[a-z2-7]{16,56}\.onion\b/gi;
  const handleRe = /(?:user|handle|alias|login|uid|username)\s*[:=]\s*["']?([A-Za-z0-9_\-.]{3,32})["']?/gi;
  const ips = [...new Set(text.match(ipRe) || [])];
  const onions = [...new Set((text.match(onionRe) || []).map((s) => s.toLowerCase()))];
  const handles = [...new Set([...text.matchAll(handleRe)].map((m) => m[1]))];
  const records = [];
  handles.forEach((h) => records.push({ handle: h, note: "Extracted from raw log upload" }));
  ips.forEach((ip) => records.push({ handle: `UnverifiedHost_${ip.replace(/\./g, "-")}`, ip, note: "IP address extracted from raw log — unverified, not yet attributed" }));
  onions.forEach((o) => records.push({ handle: `OnionSvc_${o.slice(0, 10)}`, domain: o, note: "Onion service extracted from raw log — unverified, not yet attributed" }));
  return { records, extracted: { ips: ips.length, onions: onions.length, handles: handles.length } };
}
async function submitRawLog(text, sourceLabel, analyst) {
  const { records, extracted } = parseRawLog(text);
  if (!records.length) return { received: 0, valid: 0, entities: 0, relCreated: 0, dupes: 0, warnings: 0, errors: 0, createdActorIds: [], extracted };
  const stats = await submitIntake(records, sourceLabel, analyst);
  return { ...stats, extracted };
}

// Client-side mirror of server.js's neighborhood BFS — same algorithm, same
// response shape, just walking DATA.relationships directly instead of a
// Postgres round-trip.
async function fetchNeighborhood(actorId, depth) {
  const allRels = DATA.relationships;
  const visited = new Set([actorId]);
  const relIds = new Set();
  let frontier = [actorId];
  for (let hop = 0; hop < depth && frontier.length; hop++) {
    const next = [];
    for (const rel of allRels) {
      if (frontier.includes(rel.source) && !relIds.has(rel.id)) {
        relIds.add(rel.id);
        if (!visited.has(rel.target)) { visited.add(rel.target); next.push(rel.target); }
      } else if (frontier.includes(rel.target) && !relIds.has(rel.id)) {
        relIds.add(rel.id);
        if (!visited.has(rel.source)) { visited.add(rel.source); next.push(rel.source); }
      }
    }
    frontier = next;
  }
  return { startId: actorId, depth, actorIds: [...visited], relationshipIds: [...relIds] };
}

