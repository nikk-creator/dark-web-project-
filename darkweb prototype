function Sidebar({ page, setPage, collapsed, setCollapsed }) {
  const navRef = useRef(null);
  const [indicator, setIndicator] = useState({ top: 0, height: 0 });
  const { syncState, lastSyncedAt } = useLiveSyncStatus();
  const [, forceClock] = useState(0);
  useEffect(() => { const t = setInterval(() => forceClock(x => x + 1), 1000); return () => clearInterval(t); }, []);
  let syncedAgo = "—";
  if (lastSyncedAt) {
    const secs = Math.max(0, Math.round((Date.now() - lastSyncedAt) / 1000));
    syncedAgo = secs < 5 ? "just now" : secs < 60 ? `${secs}s ago` : `${Math.round(secs / 60)}m ago`;
  }

  useEffect(() => {
    if (!navRef.current) return;
    const activeEl = navRef.current.querySelector(`[data-navkey="${page}"]`);
    if (activeEl) setIndicator({ top: activeEl.offsetTop, height: activeEl.offsetHeight });
  }, [page, collapsed]);

  return (
    <div className={`flex h-screen flex-col border-r border-slate-800 bg-slate-950 transition-all ${collapsed ? "w-16" : "w-60"}`}>
      <div className="flex items-center gap-2 border-b border-slate-800 px-4 py-4">
        <div className="flex h-7 w-7 shrink-0 items-center justify-center rounded bg-cyan-500/15 border border-cyan-500/30">
          <Radar size={15} className="text-cyan-400" />
