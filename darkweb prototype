/* ---------------------------- ATTRIBUTION NETWORK (graph) ---------------------------- */
function forceCluster(strength) {
  let nodes;
  function force(alpha) {
    const centroids = {};
    nodes.forEach(n => {
      const c = centroids[n.category] || (centroids[n.category] = { x: 0, y: 0, n: 0 });
      c.x += n.x; c.y += n.y; c.n += 1;
    });
    Object.values(centroids).forEach(c => { c.x /= c.n; c.y /= c.n; });
    nodes.forEach(n => {
      const c = centroids[n.category];
      n.vx += (c.x - n.x) * strength * alpha;
      n.vy += (c.y - n.y) * strength * alpha;
    });
  }
  force.initialize = (_nodes) => { nodes = _nodes; };
  return force;
}
const CAT_HALO_COLORS = { "Financial Crime": "#22d3ee", "Data Theft": "#f59e0b", "Initial Access": "#fb7185", "Fraud": "#a78bfa", "Malware": "#34d399", "Other": "#94a3b8" };

function AttributionNetwork({ focusActorId, goActor, dataVersion, pulseIds }) {
  const svgRef = useRef(null);
  const [nodeFilter, setNodeFilter] = useState({ Actor: true });
  const [relFilterSet, setRelFilterSet] = useState(new Set(REL_TYPES));
  const [selectedRel, setSelectedRel] = useState(null);
  const [selectedNode, setSelectedNode] = useState(focusActorId || null);
  const [search, setSearch] = useState("");
  const [dims] = useState({ w: 900, h: 560 });
  const [scrubDay, setScrubDay] = useState(365);
  const [playing, setPlaying] = useState(false);
  const [showClusters, setShowClusters] = useState(true);
  const [expandFocus, setExpandFocus] = useState(null); // { actorIds: Set, relationshipIds: Set } | null
  const [expanding, setExpanding] = useState(false);

  useEffect(() => { setSelectedNode(focusActorId || null); }, [focusActorId]);
  useEffect(() => {
    if (!playing) return;
    const t = setInterval(() => setScrubDay(d => { if (d >= 365) { setPlaying(false); return 365; } return d + 6; }), 130);
    return () => clearInterval(t);
  }, [playing]);

  const scrubDate = useMemo(() => { const d = new Date(); d.setDate(d.getDate() - (365 - scrubDay)); return d.toISOString().slice(0, 10); }, [scrubDay]);

  // Real server round-trip — BFS graph traversal over /api/actors/:id/neighborhood,
  // the same "click a node, expand its N-hop neighborhood" pattern a Cypher
  // MATCH query would answer, just running on Postgres underneath.
  async function expandNeighborhood(actorId) {
    setExpanding(true);
    try {
      const data = await fetchNeighborhood(actorId, 2);
      setExpandFocus({ actorIds: new Set(data.actorIds), relationshipIds: new Set(data.relationshipIds) });
      notifyToast(`Expanded to ${data.actorIds.length}-node neighborhood (depth 2)`, "success");
    } catch (e) {
      notifyToast("Couldn't reach the neighborhood query", "error");
    }
    setExpanding(false);
  }

  const graphData = useMemo(() => {
    let nodes = DATA.actors.map(a => ({ id: a.id, label: a.primaryAlias, risk: a.riskLevel, category: a.category }));
    let links = DATA.relationships.filter(r => {
      if (!relFilterSet.has(r.type)) return false;
      const ev = DATA.evidence.find(e => e.id === r.evidenceId);
      return !ev || (ev.observedAt || "0000") <= scrubDate;
    }).map(r => ({ ...r }));
    if (expandFocus) {
      nodes = nodes.filter(n => expandFocus.actorIds.has(n.id));
      links = links.filter(l => expandFocus.relationshipIds.has(l.id));
    }
    return { nodes, links };
    // dataVersion is a bump counter, not read directly — its only job is to
    // force this to recompute when Socket.IO tells us DATA just changed.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [relFilterSet, scrubDate, expandFocus, dataVersion]);

  useEffect(() => {
    const svg = d3.select(svgRef.current);
    svg.selectAll("*").remove();
    const { w, h } = dims;
    const nodes = graphData.nodes.map(d => ({ ...d }));
    const links = graphData.links.map(d => ({ ...d, source: d.source, target: d.target }));

    const g = svg.append("g");
    svg.call(d3.zoom().scaleExtent([0.3, 3]).on("zoom", (ev) => g.attr("transform", ev.transform)));

    const haloLayer = g.append("g");
    const haloEls = Object.keys(CAT_HALO_COLORS).map(cat => haloLayer.append("ellipse").attr("fill", CAT_HALO_COLORS[cat]).attr("opacity", 0));
    if (showClusters) haloLayer.selectAll("ellipse").transition().duration(700).delay(150).attr("opacity", 0.07);

    const sim = d3.forceSimulation(nodes)
      .force("link", d3.forceLink(links).id(d => d.id).distance(90).strength(0.35))
      .force("charge", d3.forceManyBody().strength(-160))
      .force("center", d3.forceCenter(w / 2, h / 2))
      .force("collide", d3.forceCollide(26))
      .force("cluster", forceCluster(showClusters ? 0.06 : 0));

    const riskColor = { Critical: "#fb7185", High: "#f59e0b", Medium: "#22d3ee", Low: "#94a3b8" };

    const link = g.append("g").selectAll("line").data(links).join("line")
      .attr("stroke", d => d.confidence >= 75 ? "#22d3ee" : d.confidence >= 50 ? "#f59e0b" : "#64748b")
      .attr("stroke-opacity", 0)
      .attr("stroke-width", d => Math.max(1, d.confidence / 35))
      .style("cursor", "pointer")
      .on("click", (_, d) => setSelectedRel(d));
    link.transition().duration(500).delay((_, i) => 200 + i * 5).attr("stroke-opacity", 0.55);

    const node = g.append("g").selectAll("g").data(nodes).join("g")
      .style("cursor", "pointer")
      .call(d3.drag()
        .on("start", (ev, d) => { if (!ev.active) sim.alphaTarget(0.2).restart(); d.fx = d.x; d.fy = d.y; })
        .on("drag", (ev, d) => { d.fx = ev.x; d.fy = ev.y; })
        .on("end", (ev, d) => { if (!ev.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }))
      .on("click", (_, d) => { setSelectedNode(d.id); goActor && goActor(d.id, true); });

    // Radar-ping pulse behind the focused node, AND behind any node that
    // just arrived live via Socket.IO (pulseIds) — the visual cue that
    // draws the eye to newly discovered intelligence the moment it lands.
    const pulseSet = new Set(pulseIds || []);
    const pingGroup = node.filter(d => d.id === selectedNode || pulseSet.has(d.id)).append("g");
    const pingCircle = pingGroup.append("circle")
      .attr("r", 10).attr("fill", "none")
      .attr("stroke", d => pulseSet.has(d.id) && d.id !== selectedNode ? "#4ade80" : (riskColor[d.risk] || "#22d3ee"))
      .attr("stroke-width", 2);
    pingCircle.append("animate").attr("attributeName", "r").attr("values", "10;22;10").attr("dur", "2s").attr("repeatCount", "indefinite");
    pingCircle.append("animate").attr("attributeName", "opacity").attr("values", "0.6;0;0.6").attr("dur", "2s").attr("repeatCount", "indefinite");

    node.append("circle")
      .attr("r", 0)
      .attr("fill", d => riskColor[d.risk] || "#64748b")
      .attr("fill-opacity", 0)
      .attr("stroke", "#0f172a").attr("stroke-width", 1.5)
      .transition().duration(450).delay((_, i) => i * 12).ease(d3.easeBackOut.overshoot(1.6))
      .attr("r", 10)
      .attr("fill-opacity", d => selectedNode ? (d.id === selectedNode ? 1 : 0.35) : 0.85);

    node.append("text")
      .text(d => d.label)
      .attr("x", 13).attr("y", 4)
      .attr("font-size", 9.5)
      .attr("fill", d => selectedNode ? (d.id === selectedNode ? "#e2e8f0" : "#64748b") : "#cbd5e1")
      .attr("opacity", 0)
      .style("font-family", "ui-monospace, monospace")
      .transition().duration(400).delay((_, i) => 200 + i * 12).attr("opacity", 1);

    sim.on("tick", () => {
      link.attr("x1", d => d.source.x).attr("y1", d => d.source.y).attr("x2", d => d.target.x).attr("y2", d => d.target.y);
      node.attr("transform", d => `translate(${d.x},${d.y})`);
      if (showClusters) {
        Object.keys(CAT_HALO_COLORS).forEach((cat, i) => {
          const pts = nodes.filter(n => n.category === cat);
          if (!pts.length) { haloEls[i].attr("r", 0); return; }
          const cx = pts.reduce((s, p) => s + p.x, 0) / pts.length, cy = pts.reduce((s, p) => s + p.y, 0) / pts.length;
          const r = Math.max(40, ...pts.map(p => Math.hypot(p.x - cx, p.y - cy) + 30));
          haloEls[i].attr("cx", cx).attr("cy", cy).attr("rx", r).attr("ry", r);
        });
      }
    });

    // Flowing particles on high-confidence edges — a continuous rAF loop
    // (not the physics tick, which stops once the layout settles) so the
    // "live correlation" effect keeps animating indefinitely. Reads
    // source/target .x/.y fresh every frame, so it stays correctly
    // positioned even while the user drags nodes around.
    const highConfLinks = links.filter(l => l.confidence >= 75);
    const particleData = highConfLinks.map(l => ({ link: l, phase: Math.random() }));
    const particles = g.append("g").selectAll("circle.flow-particle").data(particleData).join("circle")
      .attr("class", "flow-particle").attr("r", 2.5).attr("fill", "#67e8f9").attr("opacity", 0);
    particles.transition().duration(500).delay(900).attr("opacity", 0.9);
    let rafId;
    const speed = 2600; // ms per full edge traversal
    function tickParticles(time) {
      particles.attr("cx", d => {
        const t = ((time / speed) + d.phase) % 1;
        return d.link.source.x + (d.link.target.x - d.link.source.x) * t;
      }).attr("cy", d => {
        const t = ((time / speed) + d.phase) % 1;
        return d.link.source.y + (d.link.target.y - d.link.source.y) * t;
      });
      rafId = requestAnimationFrame(tickParticles);
    }
    if (highConfLinks.length) rafId = requestAnimationFrame(tickParticles);

    return () => { sim.stop(); if (rafId) cancelAnimationFrame(rafId); };
  }, [graphData, selectedNode, showClusters, pulseIds]);

  const toggleRel = (t) => {
    setRelFilterSet(prev => {
      const next = new Set(prev);
      next.has(t) ? next.delete(t) : next.add(t);
      return next;
    });
  };

  const highlighted = DATA.actors.filter(a => search && a.primaryAlias.toLowerCase().includes(search.toLowerCase())).slice(0, 5);

  return (
    <div>
      <SectionHeader title="Attribution Network" sub="Interactive relationship graph linking actors, identifiers and infrastructure." crumbs={["UMBRA", "Attribution Network"]} right={<DemoTag />} />
      <div className="mb-3 flex flex-wrap items-center gap-3 rounded-lg border border-slate-800 bg-slate-900/60 p-3">
        <button onClick={() => setPlaying(p => !p)} className="flex h-7 w-7 items-center justify-center rounded border border-slate-800 text-slate-300 hover:border-slate-600">{playing ? <Minus size={13} /> : <ChevronRight size={13} />}</button>
        <input type="range" min={0} max={365} value={scrubDay} onChange={e => setScrubDay(Number(e.target.value))} className="w-56" />
        <span className="font-mono text-[11px] text-slate-400">{scrubDate}</span>
        <span className="text-[11px] text-slate-500">— relationships appear as their supporting evidence was observed</span>
