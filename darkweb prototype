  const [evidenceOpenId, setEvidenceOpenId] = useState(null);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState(null);
  const [analystIdx, setAnalystIdx] = useState(0);
  const [registryFilter, setRegistryFilter] = useState(null);
  const currentAnalyst = ANALYSTS[analystIdx];
  const [dataVersion, setDataVersion] = useState(0);
  const [pulseIds, setPulseIds] = useState([]);
  const { syncState, lastSyncedAt } = useLiveSyncStatus();
  const [, forceClock] = useState(0); // re-render just to tick the "synced Xs ago" label

  useEffect(() => {
    let cancelled = false;
    loadData()
      .then(() => { if (!cancelled) { setDataVersion(DATA_VERSION); setLoading(false); } })
      .catch((e) => { if (!cancelled) { setLoadError(e.message); setLoading(false); } });
    return () => { cancelled = true; };
  }, []);

  // Real (if modest) live sync: this artifact has no Socket.IO server to push
  // through, but window.storage gives every tab/session a shared case file.
  // Poll it — any actor another session just ingested lands here, bumps
  // dataVersion (which forces the current page to recompute/remount), and
  // gets a pulse ring in the Attribution Network the moment it's noticed.
  useEffect(() => {
    let cancelled = false;
    const tick = async () => {
      const newIds = await pullRemoteState();
      if (cancelled) return;
      if (newIds && newIds.length) {
        setPulseIds(newIds);
        setTimeout(() => { if (!cancelled) setPulseIds([]); }, 6000);
      }
      setDataVersion(DATA_VERSION);
    };
    const interval = setInterval(tick, 4000);
    return () => { cancelled = true; clearInterval(interval); };
  }, []);

  // Ticks the header/sidebar's relative "synced Xs ago" label every second.
  useEffect(() => {
    const t = setInterval(() => forceClock((x) => x + 1), 1000);
    return () => clearInterval(t);
  }, []);

  // Any local mutation (submitting intake, confirming evidence, adding a
  // hypothesis, a review…) calls persistState(), which pings this listener
  // immediately — so the current page reflects it right away, not just on
  // the next 4s poll. Cross-tab arrivals also flow through the same path.
  useEffect(() => {
    const listener = () => setDataVersion(DATA_VERSION);
    _syncListeners.push(listener);
    return () => { _syncListeners = _syncListeners.filter((l) => l !== listener); };
  }, []);

  // Recomputed on every render, including the once-a-second clock tick above
  // — deliberately not memoized, since its whole job is to go stale visibly.
  let syncedAgo = null;
  if (lastSyncedAt) {
    const secs = Math.max(0, Math.round((Date.now() - lastSyncedAt) / 1000));
    syncedAgo = secs < 5 ? "just now" : secs < 60 ? `${secs}s ago` : `${Math.round(secs / 60)}m ago`;
  }

  const goActor = useCallback((id, staysOnNetwork) => {
    setActorId(id);
    if (!staysOnNetwork) setPage("dossier");
  }, []);
  const goEvidence = useCallback((id) => { setEvidenceOpenId(id); setPage("evidence"); }, []);

  return (
    <div className="flex h-screen w-full overflow-hidden bg-slate-950 text-slate-200" style={{ fontFamily: "'IBM Plex Sans', ui-sans-serif, system-ui", backgroundImage: "radial-gradient(circle at 15% 0%, rgba(34,211,238,0.05), transparent 45%), radial-gradient(circle at 85% 100%, rgba(167,139,250,0.04), transparent 45%)" }}>
      <style>{`
        * { font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif; }
        .font-mono, code { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
      `}</style>
      <ToastContainer />
      <Sidebar page={page} setPage={(p) => { setPage(p); }} collapsed={collapsed} setCollapsed={setCollapsed} />
      <div className="flex flex-1 flex-col overflow-hidden">
        <header className="flex items-center gap-4 border-b border-slate-800 bg-slate-950/80 px-5 py-3 backdrop-blur">
          <GlobalSearch onOpenActor={goActor} onOpenEvidence={goEvidence} />
          <div className="ml-auto flex items-center gap-3 text-[11px] text-slate-500">
            <button onClick={() => setAnalystIdx(i => (i + 1) % ANALYSTS.length)} className="flex items-center gap-1.5 rounded border border-slate-800 px-2 py-1 text-slate-300 hover:border-slate-600">
              <Users size={12} /> {currentAnalyst.name} <span className="text-slate-600">· {currentAnalyst.role}</span>
            </button>
            {syncState === "live" ? (
              <span className="flex items-center gap-1.5 rounded border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-emerald-300">
                <span className="relative flex h-1.5 w-1.5"><span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" /><span className="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400" /></span>
                Live case file — shared across tabs
              </span>
            ) : syncState === "local" ? (
              <span className="flex items-center gap-1.5 rounded border border-amber-500/30 bg-amber-500/10 px-2 py-1 text-amber-300"><span className="h-1.5 w-1.5 rounded-full bg-amber-400" /> Local session only — storage unavailable</span>
            ) : (
              <span className="flex items-center gap-1.5 rounded border border-slate-700 bg-slate-800/50 px-2 py-1 text-slate-400"><Loader2 size={11} className="animate-spin" /> Connecting…</span>
            )}
            <span className="hidden items-center gap-1 sm:flex"><RefreshCcw size={12} /> {syncedAgo ? `Synced ${syncedAgo}` : "Not yet synced"}</span>
          </div>
        </header>
        <main className="flex-1 overflow-y-auto px-5 py-5">
          {loadError ? (
            <EmptyState icon={WifiOff} title="Couldn't reach the API" sub={`${loadError} — make sure the backend is running (npm start from the project root) and migrated/seeded.`} />
          ) : loading ? <LoadingState /> : (
            <ErrorBoundary key={`${page}-${dataVersion}`} onReset={() => setPage("command")}>
              <div className="animate-in">
                {page === "command" && <CommandCenter goActor={goActor} setPage={setPage} setRegistryFilter={setRegistryFilter} />}
                {page === "registry" && <ActorRegistry goActor={goActor} presetCategory={registryFilter} />}
                {page === "dossier" && actorId && <ActorDossier actorId={actorId} goActor={goActor} setPage={setPage} goEvidence={goEvidence} currentAnalyst={currentAnalyst} />}
                {page === "dossier" && !actorId && <EmptyState title="No actor selected" sub="Open an actor from the registry, search, or the attribution network." />}
                {page === "network" && <AttributionNetwork focusActorId={actorId} goActor={goActor} dataVersion={dataVersion} pulseIds={pulseIds} />}
                {page === "evidence" && <EvidenceVault openId={evidenceOpenId} clearOpen={() => setEvidenceOpenId(null)} />}
                {page === "timeline" && <EventTimeline goActor={goActor} goEvidence={goEvidence} />}
                {page === "intake" && <IntelligenceIntake goActor={goActor} setPage={setPage} />}
                {page === "infrastructure" && <InfrastructureLens actorId={actorId} setActorId={goActor} />}
                {page === "persona" && <PersonaAnalysis />}
                {page === "reports" && <InvestigationReports />}
                {page === "settings" && <SystemSettings />}
              </div>
            </ErrorBoundary>
          )}
        </main>
      </div>
    </div>
  );
}
