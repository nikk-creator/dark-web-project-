const TLP_OPTS = [
  { id: "CLEAR", color: "text-slate-300 border-slate-600" },
  { id: "GREEN", color: "text-emerald-400 border-emerald-500/40" },
  { id: "AMBER", color: "text-amber-400 border-amber-500/40" },
  { id: "AMBER+STRICT", color: "text-amber-400 border-amber-500/40" },
  { id: "RED", color: "text-rose-400 border-rose-500/40" },
];
async function buildStixBundle(actor, evidence, relationships) {
  const taId = `threat-actor--${(await sha256Hex("ta:" + actor.id)) || actor.id}`;
  const objects = [{
    type: "threat-actor", spec_version: "2.1", id: taId,
    created: `${TODAY}T00:00:00Z`, modified: `${TODAY}T00:00:00Z`,
    name: actor.primaryAlias, aliases: actor.aliases,
    threat_actor_types: [actor.category.toLowerCase().replace(/ /g, "-")],
    description: `UMBRA attribution record — illustrative only. ${actor.id}.`,
  }];
  for (const e of evidence) {
    const indId = `indicator--${(await sha256Hex("ind:" + e.id)) || e.id}`;
    objects.push({
      type: "indicator", spec_version: "2.1", id: indId,
      created: `${e.collectedAt}T00:00:00Z`, modified: `${(e.lastConfirmed || e.observedAt)}T00:00:00Z`,
      name: e.type, pattern_type: "stix", pattern: `[x-umbra:evidence = '${(e.description || "").replace(/'/g, "")}']`,
      valid_from: `${e.observedAt}T00:00:00Z`, labels: [e.type.toLowerCase()],
      x_confidence: e.confidence, x_reliability: e.reliability,
    });
    objects.push({
      type: "relationship", spec_version: "2.1", id: `relationship--${(await sha256Hex("rel:" + indId + taId)) || indId}`,
      created: `${e.collectedAt}T00:00:00Z`, modified: `${e.collectedAt}T00:00:00Z`,
      relationship_type: "indicates", source_ref: indId, target_ref: taId,
    });
  }
  return { type: "bundle", id: `bundle--${(await sha256Hex("bundle:" + actor.id + TODAY)) || actor.id}`, objects };
}

function InvestigationReports() {
