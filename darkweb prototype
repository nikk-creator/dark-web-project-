function AttributionWorkbench({ actorId, currentAnalyst }) {
  const [, bump] = useState(0);
  const [activeId, setActiveId] = useState(null);
  const [expandedEv, setExpandedEv] = useState(null);
  const [auditCache, setAuditCache] = useState({});

  const hyps = hypothesesForActor(actorId);
  const active = hyps.find(h => h.id === activeId) || hyps.find(h => h.isPrimary) || hyps[0];
  const attr = active ? attributionBreakdown(actorId, active.includedRelationshipIds) : attributionBreakdown(actorId);
  const rels = relationshipsForActor(actorId);

  async function toggleRel(relId) {
    if (!active) return;
    const next = active.includedRelationshipIds.includes(relId) ? active.includedRelationshipIds.filter(id => id !== relId) : [...active.includedRelationshipIds, relId];
    await updateHypothesis(active.id, { includedRelationshipIds: next });
    bump(t => t + 1);
  }
  async function createHypothesis() {
    const h = await addHypothesis(actorId, `Alt theory ${hyps.length}`, active ? active.includedRelationshipIds : rels.map(r => r.id));
    setActiveId(h.id);
    bump(t => t + 1);
  }
  async function toggleExpand(evidenceId) {
    const isOpen = expandedEv === evidenceId;
    setExpandedEv(isOpen ? null : evidenceId);
    if (!isOpen && !auditCache[evidenceId]) {
      const rows = await getAudit(evidenceId);
      setAuditCache(c => ({ ...c, [evidenceId]: rows }));
    }
  }
  async function doConfirm(evidenceId) {
    await confirmEvidence(evidenceId, currentAnalyst.name);
    setAuditCache(c => { const n = { ...c }; delete n[evidenceId]; return n; });
    bump(t => t + 1);
    if (expandedEv === evidenceId) { const rows = await getAudit(evidenceId); setAuditCache(c => ({ ...c, [evidenceId]: rows })); }
  }

  if (!active) return <EmptyState title="No attribution theory recorded" />;

  return (
    <div>
      <div className="mb-3 flex flex-wrap items-center gap-2">
        {hyps.map(h => (
          <button key={h.id} onClick={() => setActiveId(h.id)} className={`rounded border px-2.5 py-1.5 text-[12px] ${active.id === h.id ? "border-cyan-500/40 bg-cyan-500/10 text-cyan-300" : "border-slate-800 text-slate-400"}`}>
            {h.label}
          </button>
        ))}
        <button onClick={createHypothesis} className="rounded border border-dashed border-slate-700 px-2.5 py-1.5 text-[12px] text-slate-500 hover:border-slate-600 hover:text-slate-300">+ New hypothesis</button>
      </div>
      {active.note && <p className="mb-3 text-[12px] italic text-slate-500">{active.note}</p>}

      <div className="grid grid-cols-1 gap-3 lg:grid-cols-3">
        <div className="rounded-lg border border-slate-800 bg-slate-900/60 p-4 text-center">
          <div className="text-[11px] uppercase tracking-wide text-slate-500">Attribution Confidence Score</div>
          <div className={`mt-1 text-4xl font-semibold ${attr.overall >= 75 ? "text-emerald-400" : attr.overall >= 50 ? "text-amber-400" : "text-rose-400"}`}>{attr.overall}%</div>
          <div className="mt-2"><FPBadge level={attr.fpRisk} /> <span className="ml-1 text-[11px] text-slate-500">False Positive Risk</span></div>
          <div className="mt-1 text-[11px] text-slate-600">{active.includedRelationshipIds.length} of {rels.length} relationships included</div>
          <ResponsiveContainer width="100%" height={150}>
            <RadarChart data={[
              { dim: "Infra", val: attr.infrastructure },
              { dim: "ID", val: attr.identifier },
              { dim: "PGP", val: attr.pgp },
              { dim: "Wallet", val: attr.wallet },
              { dim: "Persona", val: attr.persona },
              { dim: "Behavior", val: attr.behavioral },
            ]} outerRadius="72%">
              <PolarGrid stroke="#1e293b" />
              <PolarAngleAxis dataKey="dim" tick={{ fontSize: 9, fill: "#64748b" }} />
              <RadarShape dataKey="val" stroke="#22d3ee" fill="#22d3ee" fillOpacity={0.32} strokeWidth={1.5}
                isAnimationActive animationDuration={550} animationEasing="ease-out" />
            </RadarChart>
          </ResponsiveContainer>
        </div>
        <div className="rounded-lg border border-slate-800 bg-slate-900/60 p-4 lg:col-span-2">
          <div className="mb-2 text-sm font-medium text-slate-200">Weighted scoring model — this hypothesis</div>
          {[
            ["Infrastructure correlation", attr.infrastructure, WEIGHTS.infrastructure],
            ["Identifier correlation", attr.identifier, WEIGHTS.identifier],
            ["PGP correlation", attr.pgp, WEIGHTS.pgp],
            ["Wallet correlation", attr.wallet, WEIGHTS.wallet],
            ["Persona similarity", attr.persona, WEIGHTS.persona],
            ["Behavioral similarity", attr.behavioral, WEIGHTS.behavioral],
          ].map(([label, val, w]) => (
            <div key={label} className="mb-2 flex items-center gap-2 text-[12px]">
              <span className="w-44 shrink-0 text-slate-400">{label} <span className="text-slate-600">({Math.round(w * 100)}%)</span></span>
              <div className="h-1.5 flex-1 rounded-full bg-slate-800"><div className="h-1.5 rounded-full bg-cyan-500 transition-all duration-500 ease-out" style={{ width: `${val}%` }} /></div>
              <span className="w-9 text-right font-mono text-slate-300">{val}%</span>
            </div>
          ))}
        </div>
      </div>

      <div className="mt-3 rounded-lg border border-slate-800 bg-slate-900/60 p-4">
        <div className="mb-1 text-sm font-medium text-slate-200">What-if sandbox — toggle relationships to see how fragile this score is</div>
        <p className="mb-3 text-[11px] text-slate-500">Each relationship's contribution is discounted by how long it's been since its supporting evidence was reconfirmed (30-day grace period, then decaying to a 35% floor).</p>
        <div className="space-y-2">
          {rels.map(r => {
            const ev = evidenceForRel(r);
            const included = active.includedRelationshipIds.includes(r.id);
            const days = ev ? daysBetween(ev.lastConfirmed || ev.observedAt, TODAY) : null;
            const decay = ev ? decayFactor(days) : 1;
            const other = r.source === actorId ? actorById(r.target) : actorById(r.source);
            const isOpen = expandedEv === r.evidenceId;
            const weak = r.type === "SHARED_WALLET" || (ev && sourceReliability(ev.source) === "E");
            return (
              <div key={r.id} className={`rounded border p-3 ${included ? "border-slate-800 bg-slate-900/40" : "border-slate-800/50 opacity-50"}`}>
                <div className="flex items-start gap-3">
                  <input type="checkbox" checked={included} onChange={() => toggleRel(r.id)} className="mt-1" />
                  <div className="min-w-0 flex-1">
                    <div className="flex flex-wrap items-center gap-2 text-[12px]">
                      <span className="rounded border border-slate-700 px-1.5 py-0.5 font-mono text-[10px] text-slate-300">{r.type}</span>
                      <span className="font-mono text-slate-200">{other?.primaryAlias}</span>
                      <ConfidenceBadge value={Math.round(effectiveConfidence(r))} />
                      {r.confidence !== Math.round(effectiveConfidence(r)) && <span className="text-[10px] text-slate-600">(raw {r.confidence}%, decayed)</span>}
                      <FPBadge level={r.falsePositiveRisk} />
                      {weak && <span className="flex items-center gap-1 text-[10px] text-amber-400"><AlertTriangle size={10} /> weak indicator type</span>}
                    </div>
                    <p className="mt-1 text-[12px] text-slate-500">{r.reason}</p>
                    {ev && (
                      <div className="mt-2 flex flex-wrap items-center gap-2 text-[11px]">
                        <span className={decay >= 0.85 ? "text-emerald-400" : decay >= 0.6 ? "text-amber-400" : "text-rose-400"}>{Math.round(decay * 100)}% fresh · confirmed {days}d ago</span>
                        <button onClick={() => doConfirm(r.evidenceId)} className="flex items-center gap-1 rounded border border-slate-800 px-2 py-0.5 text-slate-300 hover:border-slate-600"><CheckCircle2 size={11} /> Confirm now</button>
                        <button onClick={() => toggleExpand(r.evidenceId)} className="flex items-center gap-1 text-slate-500 hover:text-slate-300"><History size={11} /> {isOpen ? "Hide" : "Chain of custody"}</button>
                        <span className="font-mono text-[10px] text-slate-700">{ev.hash}</span>
                      </div>
                    )}
                    {isOpen && (
                      <div className="mt-2 rounded border border-slate-800 bg-slate-950 p-2">
                        {(auditCache[r.evidenceId] || []).map(a => (
                          <div key={a.id} className="text-[10.5px] text-slate-500">{new Date(a.createdAt).toLocaleString()} — {a.analyst}: {a.action}</div>
                        ))}
                        {!auditCache[r.evidenceId] && <div className="text-[10.5px] text-slate-600">Loading…</div>}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
          {rels.length === 0 && <div className="text-[12px] text-slate-500">No relationships recorded for this actor.</div>}
        </div>
      </div>

      <div className="mt-3 rounded-lg border border-cyan-500/20 bg-cyan-500/5 p-4 text-[12px] text-cyan-200">
        <span className="font-medium">UMBRA Analyst:</span> The strongest indicators for this hypothesis are {attr.infrastructure >= attr.pgp ? "infrastructure correlation and certificate reuse" : "shared PGP identifiers"}.
        Persona similarity provides supporting, not conclusive, evidence. Assessment is based on correlated digital indicators and does not independently establish a real-world identity.
      </div>
    </div>
  );
}

function TeamReview({ actorId, currentAnalyst }) {
  const [reviews, setReviews] = useState(null);
  const [comment, setComment] = useState("");
  const [showDissent, setShowDissent] = useState(false);

  async function load() { setReviews(await getReviews(actorId)); }
  useEffect(() => { load(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [actorId]);

  const status = deriveReviewStatus(reviews || []);
  const alreadyConfirmed = (reviews || []).some(r => r.type === "confirm" && r.analyst === currentAnalyst.name);

  async function submit(type, text) {
    await addReview(actorId, currentAnalyst.name, type, text || null);
    await load();
  }

  return (
    <div className="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
