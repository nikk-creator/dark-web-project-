function actorById(id) { return DATA.actors.find(a => a.id === id); }
function relationshipsForActor(id) { return DATA.relationships.filter(r => r.source === id || r.target === id); }
function evidenceForActor(id) { return DATA.evidence.filter(e => e.actorId === id); }
function infraForActor(id) { return DATA.infrastructure.filter(i => i.actorId === id); }
function timelineForActor(id) { return DATA.timelineEvents.filter(t => t.actorId === id); }
function personaForActor(id) { return DATA.personaAnalysis.filter(p => p.actorA === id || p.actorB === id); }
function sourceReliability(name) { const s = DATA.sources.find(s => s.name === name); return s ? s.reliability : "C"; }
