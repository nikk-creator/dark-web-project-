function ActorComparison({ initialA, initialB }) {
  const [a, setA] = useState(initialA || DATA.actors[0]?.id || null);
  const [b, setB] = useState(initialB || DATA.actors[1]?.id || null);
  if (DATA.actors.length < 2 || !a || !b) {
    return <EmptyState icon={Users} title="Not enough actors to compare" sub="Comparison needs at least two tracked actors — add more via Intelligence Intake." />;
  }
  const actorA = actorById(a), actorB = actorById(b);
  const attrA = attributionBreakdown(a), attrB = attributionBreakdown(b);
  const sharedPGP = DATA.pgpKeys.filter(p => p.actorId === a).some(p1 => DATA.pgpKeys.filter(p => p.actorId === b).some(p2 => p2.fingerprint === p1.fingerprint));
  const rel = DATA.relationships.find(r => (r.source === a && r.target === b) || (r.source === b && r.target === a));
  const similarity = rel ? rel.confidence : Math.round((attrA.overall + attrB.overall) / 4);

  const rows = [
    ["Aliases", actorA.aliases.join(", "), actorB.aliases.join(", ")],
    ["Category", actorA.category, actorB.category],
    ["PGP", DATA.pgpKeys.find(p => p.actorId === a)?.fingerprint, DATA.pgpKeys.find(p => p.actorId === b)?.fingerprint],
    ["Wallet", DATA.wallets.find(w => w.actorId === a)?.address, DATA.wallets.find(w => w.actorId === b)?.address],
    ["Domain", infraForActor(a)[0]?.domain, infraForActor(b)[0]?.domain],
    ["Certificate", infraForActor(a)[0]?.certFingerprint, infraForActor(b)[0]?.certFingerprint],
    ["First Seen", actorA.firstSeen, actorB.firstSeen],
    ["Attribution Confidence", `${attrA.overall}%`, `${attrB.overall}%`],
  ];

  return (
    <div className="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
      <div className="mb-3 flex flex-wrap items-center gap-2">
        <select value={a} onChange={e => setA(e.target.value)} className="rounded border border-slate-800 bg-slate-900 px-2 py-1.5 text-[12px] text-slate-300">
          {DATA.actors.map(x => <option key={x.id} value={x.id}>{x.primaryAlias}</option>)}
        </select>
        <GitCompare size={14} className="text-slate-500" />
        <select value={b} onChange={e => setB(e.target.value)} className="rounded border border-slate-800 bg-slate-900 px-2 py-1.5 text-[12px] text-slate-300">
          {DATA.actors.map(x => <option key={x.id} value={x.id}>{x.primaryAlias}</option>)}
        </select>
      </div>
      <div className="overflow-hidden rounded border border-slate-800">
        <table className="w-full text-[12px]">
          <tbody>
            {rows.map(([label, va, vb]) => (
              <tr key={label} className="border-t border-slate-800/70 first:border-0">
                <td className="w-1/3 px-3 py-2 text-slate-500">{label}</td>
                <td className={`px-3 py-2 font-mono ${va && va === vb ? "text-emerald-400" : "text-slate-300"}`}>{va || "—"}</td>
                <td className={`px-3 py-2 font-mono ${vb && va === vb ? "text-emerald-400" : "text-slate-300"}`}>{vb || "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div className="mt-3 flex items-center justify-between rounded border border-slate-800 bg-slate-900 p-3">
        <div>
          <div className="text-[11px] uppercase tracking-wide text-slate-500">Similarity Assessment</div>
          <div className="text-[13px] text-slate-300">{sharedPGP ? "Shared PGP identifier detected — strong overlap signal." : "No direct shared identifier detected between these two actors."}</div>
        </div>
        <ConfidenceBadge value={similarity} />
      </div>
      <div className="mt-2 rounded border border-cyan-500/20 bg-cyan-500/5 p-3 text-[12px] text-cyan-200">
        Potential common identity: <span className="font-medium">{confidenceTier(similarity)}</span> confidence. {rel ? rel.reason : "Comparison is based on available overlapping indicators only; treat as investigative lead, not confirmation."}
      </div>
    </div>
  );
}

