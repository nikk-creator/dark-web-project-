  const [sortDir, setSortDir] = useState("desc");
  const pageSize = 10;

  const rows = useMemo(() => {
    return DATA.actors.map(a => {
      const attr = attributionBreakdown(a.id);
      const persona = personaForActor(a.id);
      const personaScore = persona.length ? Math.round(persona.reduce((s, p) => s + p.similarity, 0) / persona.length) : null;
      return { a, attr, personaScore };
    });
  }, []);

  const filtered = useMemo(() => {
    return rows.filter(({ a }) => {
      if (q && !(a.primaryAlias.toLowerCase().includes(q.toLowerCase()) || a.aliases.some(al => al.toLowerCase().includes(q.toLowerCase())) || a.id.toLowerCase().includes(q.toLowerCase()))) return false;
      if (category !== "All" && a.category !== category) return false;
      if (risk !== "All" && a.riskLevel !== risk) return false;
      if (status !== "All" && a.status !== status) return false;
      return true;
    });
  }, [rows, q, category, risk, status]);

  const RISK_ORDER = { Critical: 3, High: 2, Medium: 1, Low: 0 };
  const sorted = useMemo(() => {
    const dir = sortDir === "asc" ? 1 : -1;
    const arr = [...filtered];
    arr.sort((x, y) => {
      let vx, vy;
      switch (sortKey) {
        case "id": vx = x.a.id; vy = y.a.id; break;
        case "alias": vx = x.a.primaryAlias; vy = y.a.primaryAlias; break;
        case "category": vx = x.a.category; vy = y.a.category; break;
        case "firstSeen": vx = x.a.firstSeen; vy = y.a.firstSeen; break;
        case "lastSeen": vx = x.a.lastSeen; vy = y.a.lastSeen; break;
        case "confidence": vx = x.attr.overall; vy = y.attr.overall; break;
        case "infra": vx = x.attr.relCount; vy = y.attr.relCount; break;
        case "persona": vx = x.personaScore ?? -1; vy = y.personaScore ?? -1; break;
        case "risk": vx = RISK_ORDER[x.a.riskLevel]; vy = RISK_ORDER[y.a.riskLevel]; break;
        default: vx = x.a.lastSeen; vy = y.a.lastSeen;
      }
      if (vx < vy) return -1 * dir;
      if (vx > vy) return 1 * dir;
      return 0;
    });
    return arr;
  }, [filtered, sortKey, sortDir]);

  const totalPages = Math.max(1, Math.ceil(sorted.length / pageSize));
  const pageItems = sorted.slice((page - 1) * pageSize, page * pageSize);

  useEffect(() => { setPage(1); }, [q, category, risk, status]);

