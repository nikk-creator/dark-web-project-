          <div className="min-w-0">
            <div className="text-sm font-semibold tracking-wide text-slate-100">UMBRA</div>
            <div className="truncate text-[10px] text-slate-500">Attribution &amp; Intelligence</div>
          </div>
        )}
      </div>
      <nav ref={navRef} className="relative flex-1 space-y-0.5 overflow-y-auto p-2">
        <div
          className="absolute left-2 right-2 rounded-md border border-cyan-500/20 bg-cyan-500/10 transition-all duration-300 ease-out"
          style={{ top: indicator.top, height: indicator.height }}
        />
        {NAV.map(item => {
          const Icon = item.icon;
          const active = page === item.key;
          return (
            <button
              key={item.key}
              data-navkey={item.key}
              onClick={() => setPage(item.key)}
              title={collapsed ? item.label : undefined}
              className={`relative z-10 flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-[13px] ${active ? "text-cyan-300" : "text-slate-400 hover:text-slate-200"}`}
