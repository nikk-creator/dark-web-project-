/* ---------------------------- Global Search ---------------------------- */
function GlobalSearch({ onOpenActor, onOpenEvidence }) {
  const [q, setQ] = useState("");
  const [open, setOpen] = useState(false);
  const results = useMemo(() => {
    if (q.trim().length < 2) return [];
    const query = q.toLowerCase();
    const out = [];
    DATA.actors.forEach(a => {
      if (a.primaryAlias.toLowerCase().includes(query) || a.aliases.some(al => al.toLowerCase().includes(query)) || a.id.toLowerCase().includes(query)) {
        out.push({ kind: "Actor", id: a.id, label: a.primaryAlias, sub: a.category, confidence: attributionBreakdown(a.id).overall, lastSeen: a.lastSeen });
      }
    });
    DATA.pgpKeys.forEach(p => { if (p.fingerprint.toLowerCase().includes(query)) out.push({ kind: "PGP Fingerprint", id: p.actorId, label: p.fingerprint, sub: actorById(p.actorId)?.primaryAlias, confidence: null, lastSeen: p.firstSeen }); });
    DATA.wallets.forEach(w => { if (w.address.toLowerCase().includes(query)) out.push({ kind: "Wallet", id: w.actorId, label: w.address, sub: `${w.chain} · ${actorById(w.actorId)?.primaryAlias}`, confidence: null, lastSeen: w.firstSeen }); });
    DATA.infrastructure.forEach(i => { if (i.domain.toLowerCase().includes(query) || i.ip.includes(query) || i.certFingerprint.toLowerCase().includes(query)) out.push({ kind: "Infrastructure", id: i.actorId, label: i.domain, sub: i.ip, confidence: null, lastSeen: i.lastSeen }); });
    DATA.evidence.forEach(e => { if (e.id.toLowerCase().includes(query)) out.push({ kind: "Evidence", id: e.id, label: e.id, sub: e.description.slice(0, 60), confidence: e.confidence, lastSeen: e.observedAt, isEvidence: true }); });
    return out.slice(0, 8);
  }, [q]);

  return (
    <div className="relative w-full max-w-md">
      <div className="flex items-center gap-2 rounded-md border border-slate-800 bg-slate-900 px-3 py-1.5">
        <Search size={14} className="text-slate-500" />
        <input
          value={q}
          onChange={(e) => { setQ(e.target.value); setOpen(true); }}
          onFocus={() => setOpen(true)}
          placeholder="Search actors, handles, PGP, wallets, IPs, evidence…"
          className="w-full bg-transparent text-[13px] text-slate-200 placeholder-slate-600 outline-none"
        />
        {q && <button onClick={() => { setQ(""); setOpen(false); }}><X size={13} className="text-slate-600" /></button>}
      </div>
      {open && q.trim().length >= 2 && (
        <div className="absolute z-30 mt-1 w-full rounded-md border border-slate-800 bg-slate-900 shadow-xl">
          {results.length === 0 ? (
            <div className="p-3 text-xs text-slate-500">No matches found.</div>
          ) : results.map((r, i) => (
            <button
              key={i}
              onClick={() => { setOpen(false); setQ(""); r.isEvidence ? onOpenEvidence(r.id) : onOpenActor(r.id); }}
              className="flex w-full items-center justify-between border-b border-slate-800/70 px-3 py-2 text-left last:border-0 hover:bg-slate-800/50"
            >
              <div className="min-w-0">
                <div className="flex items-center gap-2">
                  <span className="rounded border border-slate-700 px-1 py-0.5 text-[10px] text-slate-400">{r.kind}</span>
                  <span className="truncate text-[13px] text-slate-200 font-mono">{r.label}</span>
                </div>
                <div className="truncate text-[11px] text-slate-500">{r.sub}</div>
              </div>
              <div className="flex shrink-0 items-center gap-2 pl-2 text-[11px] text-slate-500">
                {r.confidence != null && <ConfidenceBadge value={r.confidence} />}
                <span>{r.lastSeen}</span>
              </div>
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

