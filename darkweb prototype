/* ---------------------------- ERROR BOUNDARY ----------------------------
   Without this, any render-time exception thrown by a page (a bad prop, an
   unexpected undefined, etc.) unmounts the ENTIRE React tree, and the whole
   dashboard — sidebar, header, everything — just goes blank with no
   indication of what happened. This confines that failure to the page that
   caused it and shows what broke, instead of a silent blank screen. */
class ErrorBoundary extends React.Component {
  constructor(props) { super(props); this.state = { error: null }; }
  static getDerivedStateFromError(error) { return { error }; }
  componentDidCatch(error, info) { console.error("UMBRA page crashed:", error, info); }
  render() {
    if (this.state.error) {
      return (
        <div className="flex flex-col items-center justify-center gap-3 rounded-lg border border-dashed border-rose-800/60 bg-rose-500/5 py-16 text-center">
          <AlertTriangle size={26} className="text-rose-400" />
          <div className="text-sm font-medium text-rose-300">This page hit an error and couldn't render.</div>
          <div className="max-w-md text-xs text-slate-500 font-mono">{String(this.state.error?.message || this.state.error)}</div>
          <button
            onClick={() => { this.setState({ error: null }); this.props.onReset?.(); }}
            className="mt-2 rounded border border-slate-700 px-3 py-1.5 text-[12px] text-slate-300 hover:border-slate-500"
          >
            Back to Command Center
          </button>
        </div>
      );
    }
    return this.props.children;
  }
}

