  const personaMatches = DATA.personaAnalysis.length;
  const evidenceItems = DATA.evidence.length;

  const trend = useMemo(() => {
    const buckets = {};
    DATA.timelineEvents.forEach(e => {
      const week = e.timestamp.slice(0, 7);
      buckets[week] = (buckets[week] || 0) + 1;
    });
    return Object.entries(buckets).sort().map(([k, v]) => ({ month: k, observations: v }));
  }, []);

  const catData = useMemo(() => CATEGORIES.map(c => ({ name: c, value: DATA.actors.filter(a => a.category === c).length })), []);
