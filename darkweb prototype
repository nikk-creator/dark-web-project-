function deriveReviewStatus(entries) {
  if (!entries || !entries.length) return { label: "Pending review", color: "text-slate-400" };
  const last = entries[entries.length - 1];
  if (last.type === "dissent") return { label: "Disputed", color: "text-rose-400" };
  const confirmers = new Set(entries.filter(e => e.type === "confirm").map(e => e.analyst));
  if (confirmers.size >= 2) return { label: "Confirmed", color: "text-emerald-400" };
  if (confirmers.size === 1) return { label: "Peer review requested", color: "text-amber-400" };
  return { label: "Pending review", color: "text-slate-400" };
}

