            <div key={r.id} className="rounded border border-slate-800 p-2.5 text-[12px]">
              <div className="font-medium text-slate-200">{r.analyst} · {r.type === "confirm" ? "Confirmed" : "Flagged dissent"} <span className="font-normal text-slate-500">· {new Date(r.createdAt).toLocaleString()}</span></div>
              {r.comment && <div className="mt-1 text-slate-400">{r.comment}</div>}
            </div>
          ))}
        </div>
