          <ChevronDown size={11} />
        </span>
      </button>
    </th>
  );

  return (
    <div>
      <SectionHeader title="Actor Registry" sub="Threat actor profiles correlated across marketplaces, forums and infrastructure sources." crumbs={["UMBRA", "Actor Registry"]} right={<DemoTag />} />
      <div className="mb-3 flex flex-wrap items-center gap-2">
        <div className="flex min-w-[220px] flex-1 items-center gap-2 rounded border border-slate-800 bg-slate-900 px-2.5 py-1.5">
          <Search size={13} className="text-slate-500" />
          <input value={q} onChange={e => setQ(e.target.value)} placeholder="Search alias, ID…" className="w-full bg-transparent text-[12px] text-slate-200 outline-none placeholder-slate-600" />
        </div>
        <Select value={category} onChange={setCategory} options={CATEGORIES} label="Category" />
        <Select value={risk} onChange={setRisk} options={RISK_LEVELS} label="Risk" />
        <Select value={status} onChange={setStatus} options={STATUSES} label="Status" />
        <span className="ml-auto flex items-center gap-1 text-[11px] text-slate-500"><Filter size={11} />{filtered.length} results</span>
      </div>

      <div className="overflow-x-auto rounded-lg border border-slate-800">
        <table className="w-full min-w-[980px] text-left text-[12px]">
          <thead className="bg-slate-900/80 text-slate-500">
            <tr>
              <SortTh label="Actor ID" sortk="id" />
              <SortTh label="Primary Alias" sortk="alias" />
              <th className="px-3 py-2 font-medium">Known Aliases</th>
              <SortTh label="Category" sortk="category" />
              <SortTh label="First Seen" sortk="firstSeen" />
              <SortTh label="Last Seen" sortk="lastSeen" />
              <SortTh label="Confidence" sortk="confidence" />
              <SortTh label="Infra Links" sortk="infra" />
