function hypothesesForActor(actorId) { return DATA.hypotheses.filter(h => h.actorId === actorId); }

// includedRelationshipIds is optional — omit it (as most callers do) and this
// behaves exactly as the reference's original scoring, from every relationship.
// Pass a subset (from an active hypothesis, e.g. the what-if sandbox) and the
// score recomputes from just that subset, with each relationship's confidence
// discounted by how stale its supporting evidence is.
function attributionBreakdown(actorId, includedRelationshipIds) {
  const allRels = relationshipsForActor(actorId);
  const rels = includedRelationshipIds ? allRels.filter(r => includedRelationshipIds.includes(r.id)) : allRels;
  const persona = personaForActor(actorId);
  const infraScore = rels.filter(r => ["SHARED_INFRASTRUCTURE", "SAME_CERTIFICATE", "SAME_IP"].includes(r.type));
  const idScore = rels.filter(r => ["SAME_HANDLE", "COMMON_CONTACT", "ASSOCIATED_WITH"].includes(r.type));
  const pgpScore = rels.filter(r => r.type === "SHARED_PGP");
  const walletScore = rels.filter(r => r.type === "SHARED_WALLET");
  const avg = (arr) => arr.length ? Math.round(arr.reduce((s, r) => s + effectiveConfidence(r), 0) / arr.length) : 0;
  const infrastructure = avg(infraScore);
  const identifier = avg(idScore);
  const pgp = avg(pgpScore);
  const wallet = avg(walletScore);
  const personaVal = persona.length ? Math.round(persona.reduce((s, p) => s + p.similarity, 0) / persona.length) : 0;
  const behavioral = persona.length ? Math.round(persona.reduce((s, p) => s + p.posting, 0) / persona.length) : 0;
  const overall = Math.round(
    infrastructure * WEIGHTS.infrastructure + identifier * WEIGHTS.identifier +
    pgp * WEIGHTS.pgp + wallet * WEIGHTS.wallet + personaVal * WEIGHTS.persona + behavioral * WEIGHTS.behavioral
  );
  const maxFP = rels.length ? Math.max(...rels.map(r => ({ Low: 1, Medium: 2, High: 3 }[r.falsePositiveRisk]))) : 1;
  const fpRisk = maxFP === 3 ? "High" : maxFP === 2 ? "Medium" : "Low";
  return { infrastructure, identifier, pgp, wallet, persona: personaVal, behavioral, overall, fpRisk, relCount: rels.length };
}

