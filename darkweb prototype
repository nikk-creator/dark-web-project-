          <button onClick={async () => { if (comment.trim()) { await submit("dissent", comment.trim()); setComment(""); setShowDissent(false); } }} className="rounded bg-rose-500/15 border border-rose-500/30 px-3 text-[12px] text-rose-300">Submit</button>
        </div>
      )}
      <div className="mt-4">
        <div className="mb-1.5 text-[11px] font-medium uppercase tracking-wide text-slate-500">Review log</div>
        {!reviews && <div className="text-[12px] text-slate-500">Loading…</div>}
