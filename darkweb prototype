      </div>
      <p className="mb-3 text-[12px] text-slate-500">Confirmed status requires sign-off from two distinct analysts. A dissent flag overrides confirmation until resolved.</p>
      <div className="flex flex-wrap gap-2">
        <button disabled={alreadyConfirmed || !reviews} onClick={() => submit("confirm")} className={`flex items-center gap-1.5 rounded border px-3 py-1.5 text-[12px] font-medium ${alreadyConfirmed ? "border-slate-800 text-slate-600" : "border-cyan-500/30 bg-cyan-500/10 text-cyan-300 hover:bg-cyan-500/20"}`}>
          <ShieldCheck size={13} /> {alreadyConfirmed ? `Confirmed by ${currentAnalyst.name}` : `Confirm as ${currentAnalyst.name}`}
        </button>
        <button onClick={() => setShowDissent(v => !v)} className="flex items-center gap-1.5 rounded border border-slate-800 px-3 py-1.5 text-[12px] text-slate-300 hover:border-slate-600">
          <AlertTriangle size={13} /> Flag dissent
